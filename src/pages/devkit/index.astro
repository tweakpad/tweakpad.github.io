---
import Code from '../../components/Code.astro';
import Preview from '../../components/Preview.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { devkitPath, devkitSection, devkitSections } from '../../lib/devkit';
import { url } from '../../lib/url';

// DevKit's landing page, authored here like the Docs landing; every other DevKit page comes from
// the `@tweakpad/devkit` package (pages/devkit/[...slug].astro).
const sections = await devkitSections();
const headings = [
  { depth: 2, slug: 'install', text: 'Install' },
  { depth: 2, slug: 'quick-start', text: 'Quick start' },
  { depth: 2, slug: 'built-to-stay-fast', text: 'Built to stay fast' },
  ...sections.map((section) => ({ depth: 2, slug: `section-${section.id}`, text: section.label })),
];
---

<DocsLayout
  title="DevKit"
  description="A tweak panel for tuning live values while your app runs, built on Tweakpad UI's inline controls."
  headings={headings}
  section={await devkitSection()}
>
  <SectionHeader
    slot="banner"
    embedded
    eyebrow="DevKit"
    title="Tune it live"
    outline="while it runs"
    lede="A tweak panel for the values you are still deciding: bind your own objects to sliders, toggles, colors and graphs, and change them while your app runs. Built on Tweakpad UI's inline controls, with no framework."
  />
  <div class="prose">
    <Preview
      title="DevKit"
      code={`<div id="devkit-hero"></div>`}
      script={`import { Pane } from '@tweakpad/devkit';

const params = { fov: 50, mode: 'orbit', tint: { r: 0.55, g: 0.49, b: 1 } };
const pane = new Pane({ container: document.getElementById('devkit-hero'), title: 'Scene' });
const tabs = pane.addTabs({ pages: [{ title: 'Camera' }, { title: 'Stats' }] });
const lens = tabs.pages[0].addFolder({ title: 'Lens' });
lens.addBinding(params, 'fov', { min: 10, max: 120, step: 1 });
lens.addBinding(params, 'mode', { options: { Orbit: 'orbit', Fly: 'fly' } });
lens.addBinding(params, 'tint', { color: { type: 'float' } });
tabs.pages[1].addPerformanceMonitor();`}
    />

    <h2 id="install">Install</h2>
    <p>
      DevKit is its own package. It installs Tweakpad UI with it, and uses the library's stylesheet, so load that
      once as for the components.
    </p>
    <Code code="npm install @tweakpad/devkit" language="sh" />

    <h2 id="quick-start">Quick start</h2>
    <p>
      Create a pane and bind properties of your own objects to it. The pane reads them every frame and shows what
      changed, and writes them as soon as someone edits a control, so you never sync values by hand.
    </p>
    <Code
      language="ts"
      code={`import '@tweakpad/ui/styles.css';
import { Pane } from '@tweakpad/devkit';

const pane = new Pane({ title: 'Scene' });
const tabs = pane.addTabs({ pages: [{ title: 'Camera' }, { title: 'Stats' }] });
const camera = tabs.pages[0].addFolder({ title: 'Lens' });
camera.addBinding(params, 'fov', { min: 10, max: 120, step: 1 }).on('change', (e) => {});
camera.addBinding(params, 'mode', { options: { Orbit: 'orbit', Fly: 'fly' } });
camera.addBinding(params, 'tint', { color: { type: 'float' } }); // {r,g,b} in 0–1
tabs.pages[1].addPerformanceMonitor(); // FPS and frame time, memory below`}
    />

    <h2 id="built-to-stay-fast">Built to stay fast</h2>
    <p>A pane is meant to stay open next to a running scene, so it costs as little as it can.</p>
    <ul>
      <li>
        <strong>One scheduler for the page.</strong> Each frame it reads the bindings on screen with plain property
        reads, no proxies and nothing injected into your objects, and writes only what changed.
      </li>
      <li>
        <strong>Only what you can see costs anything.</strong> Bindings in a closed folder, a hidden tab or a row
        scrolled away sleep until they show again.
      </li>
      <li>
        <strong>Controls are created late, within a budget.</strong> A row is a placeholder until it first becomes
        visible, and writes to controls share a small budget per frame, so a busy pane never takes your frame.
      </li>
      <li>
        <strong>Your app sees edits at pointer rate.</strong> Your object is written on every change of a drag; a
        control being dragged or typed in is never pulled back by your app's own writes.
      </li>
    </ul>
    <p>
      The source, the measurements and the issue tracker are on <a href="https://github.com/tweakpad/devkit">GitHub</a>.
    </p>

    {
      sections.map((section) => (
        <>
          <h2 id={`section-${section.id}`}>{section.label}</h2>
          <div class="card-grid">
            {section.entries.map((entry) => (
              <a class="link-card" href={url(devkitPath(entry))}>
                <span class="chip">{section.label}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <span class="link-card__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </>
      ))
    }
  </div>
</DocsLayout>
