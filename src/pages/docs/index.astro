---
import { getEntry, render } from 'astro:content';
import SectionHeader from '../../components/SectionHeader.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { INTRO_ID } from '../../lib/content';

// The introduction is the Docs landing page: the docs shell, with the section banner opening the article.
const entry = await getEntry('docs', INTRO_ID);
if (!entry) throw new Error(`Missing docs entry "${INTRO_ID}"`);
const { Content, headings } = await render(entry);
---

<DocsLayout title="Docs" description="Guides and component references for Tweakpad UI." headings={headings}>
  <SectionHeader
    slot="banner"
    embedded
    eyebrow="Docs"
    title="Hey Doc!"
    outline="What's the plan?"
    lede="Install the package, learn the theming model, then browse each component with live examples, compact and default density, and copyable code."
  />
  <div class="prose">
    <Content />
  </div>
</DocsLayout>
