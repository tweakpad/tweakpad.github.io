---
import { render } from 'astro:content';
import ApiTable from '../../components/ApiTable.astro';
import Code from '../../components/Code.astro';
import Keys from '../../components/Keys.astro';
import Preview from '../../components/Preview.astro';
import Related from '../../components/Related.astro';
import TokenList from '../../components/TokenList.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { INTRO_ID, allDocs, docGroup, isComponentDoc, relatedOf, type DocEntry } from '../../lib/content';
import { elementApi, familyId, tokenFamilies } from '../../lib/manifest';

export async function getStaticPaths() {
  // The introduction is the Docs landing page, rendered by docs/index.astro at /docs.
  const entries = (await allDocs()).filter((entry) => entry.id !== INTRO_ID);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
const isComponent = isComponentDoc(entry);
const isWidget = docGroup(entry) === 'widgets';
const tag = 'tag' in entry.data ? entry.data.tag : undefined;
const parts = 'parts' in entry.data ? entry.data.parts : [];

/** API Reference headings for the table of contents: the page's own groups, then each part. */
const groupNames = (element: string) => {
  const api = elementApi(element);
  if (!api) return [];
  return (
    [
      ['Attributes', api.attributes],
      ['Properties', api.properties],
      ['Events', api.events],
      ['Methods', api.methods],
      ['Slots', api.slots],
      ['CSS parts', api.cssParts],
      ['CSS custom properties', api.cssProperties],
    ] as const
  ).flatMap(([name, rows]) => (rows.length ? [name] : []));
};
const groupId = (element: string, name: string) => `api-${element}-${name.toLowerCase().replace(/\s+/g, '-')}`;
/** Related is left out entirely when no component, widget or pattern uses this one. */
const related = isComponent && tag ? await relatedOf(entry.id) : [];
const tokens = 'tokens' in entry.data && entry.data.tokens;
const pageHeadings = tokens
  ? [...headings, ...tokenFamilies.map((family) => ({ depth: 2, slug: familyId(family.family), text: family.title }))]
  : isComponent && tag
    ? [
        ...headings,
        { depth: 2, slug: 'api-reference', text: 'API Reference' },
        ...groupNames(tag).map((name) => ({ depth: 3, slug: groupId(tag, name), text: name })),
        ...parts.map((part) => ({ depth: 3, slug: `api-${part}`, text: `<${part}>` })),
        ...(related.length ? [{ depth: 2, slug: 'related', text: 'Related' }] : []),
      ]
    : headings;
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={pageHeadings}>
  <header>
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="page-description">{entry.data.description}</p>
    {
      tag && (
        <div class="page-meta">
          <span class="chip">&lt;{tag}&gt;</span>
        </div>
      )
    }
  </header>
  <div class="prose" style="margin-block-start: 2.5rem">
    <Content components={{ Preview, Code, Keys }} />
    {tokens && <TokenList />}
    {
      isComponent && tag && (
        <>
          <h2 id="api-reference">API Reference</h2>
          <p class="api-note">
            Every element also accepts <code>motion-policy</code>.
          </p>
          <ApiTable tag={tag} />
          {parts.map((part) => (
            <>
              <h3 id={`api-${part}`}>
                <code>&lt;{part}&gt;</code>
              </h3>
              <ApiTable tag={part} level="h4" />
            </>
          ))}
          {related.length > 0 && (
            <>
              <h2 id="related">Related</h2>
              <p>Components, widgets and patterns that use this one.</p>
              <Related entries={related} />
            </>
          )}
        </>
      )
    }
  </div>
  {
    isWidget && (
      <script>
        // Widgets are opt-in: `@tweakpad/ui/register` never defines them.
        import '@tweakpad/ui/register/widgets';
      </script>
    )
  }
</DocsLayout>
