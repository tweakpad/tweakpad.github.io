---
import { getCollection, render } from 'astro:content';
import ApiTable from '../../components/ApiTable.astro';
import RelatedPatterns from '../../components/RelatedPatterns.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { INTRO_ID, docGroup, docSlug, isComponentDoc, type DocEntry } from '../../lib/content';

export async function getStaticPaths() {
  // The introduction is the Docs landing page, rendered by docs/index.astro at /docs.
  const entries = (await getCollection('docs')).filter((entry) => entry.id !== INTRO_ID);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
const isComponent = isComponentDoc(entry);
const isWidget = docGroup(entry) === 'widgets';
const { tag, parts, members } = entry.data;
const reference =
  entry.data.reference === false
    ? undefined
    : (entry.data.reference ?? (isWidget ? `widgets/${docSlug(entry)}` : docSlug(entry)));
const pageHeadings = isComponent
  ? [
      ...headings,
      ...(tag ? [{ depth: 2, slug: 'api-reference', text: 'API reference' }] : []),
      ...(tag ? parts.map((part) => ({ depth: 3, slug: `api-${part}`, text: `<${part}>` })) : []),
      { depth: 2, slug: 'related-patterns', text: 'Related patterns' },
    ]
  : headings;
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={pageHeadings}>
  <header>
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="page-description">{entry.data.description}</p>
    {
      isComponent && (
        <div class="page-meta">
          {tag && <span class="chip">&lt;{tag}&gt;</span>}
          {reference && (
            <a class="chip" href={`https://github.com/tweakpad/ui/blob/development/docs/${reference}.md`}>
              Reference docs ↗
            </a>
          )}
        </div>
      )
    }
  </header>
  <div class="prose" style="margin-block-start: 2.5rem">
    <Content />
    {
      isComponent && tag && (
        <>
          <h2 id="api-reference">API reference</h2>
          <ApiTable tag={tag} members={members} />
          {parts.map((part) => (
            <>
              <h3 id={`api-${part}`}>
                <code>&lt;{part}&gt;</code>
              </h3>
              <ApiTable tag={part} />
            </>
          ))}
        </>
      )
    }
    {
      isComponent && (
        <>
          <h2 id="related-patterns">Related patterns</h2>
          <p>Compositions that use this component. Open one to see how the pieces fit together.</p>
          <RelatedPatterns component={docSlug(entry)} />
        </>
      )
    }
  </div>
  {
    isWidget && (
      <script>
        // Widgets are opt-in: `@tweakpad/ui/register` never defines them.
        import '@tweakpad/ui/register/widgets';
      </script>
    )
  }
</DocsLayout>
