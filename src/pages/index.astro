---
import Autopilot from '../components/Autopilot.astro';
import FluidBackground from '../components/FluidBackground.astro';
import PatternCanvas from '../components/PatternCanvas.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { uiVersion } from '../lib/manifest';
import { url } from '../lib/url';

const install = 'npm install @tweakpad/ui lit';

---

<BaseLayout title="Tweakpad UI" immersive>
  <div class="home">
    <script is:inline data-astro-rerun>document.currentScript.parentElement.dataset.experience = "intro"; document.currentScript.parentElement.dataset.intro = 'loading'; document.currentScript.parentElement.inert = true;</script>

    <template data-intro-border>
      <tp-mo-segment-border trigger="none" style="--tp-mo-segment-border-color: transparent; --tp-mo-border-segment-color: var(--tp-border)">
        <div data-intro-surface></div>
        <tp-mo-border-segment draw="top-left top-left, top-left top-right" leave="top-right top-right"></tp-mo-border-segment>
        <tp-mo-border-segment draw="top-right top-right, top-right bottom-right" leave="bottom-right bottom-right"></tp-mo-border-segment>
        <tp-mo-border-segment draw="bottom-right bottom-right, bottom-right bottom-left" leave="bottom-left bottom-left"></tp-mo-border-segment>
        <tp-mo-border-segment draw="bottom-left bottom-left, bottom-left top-left" leave="top-left top-left"></tp-mo-border-segment>
      </tp-mo-segment-border>
    </template>
    <div class="home__stage">
      <FluidBackground />
      <PatternCanvas>
        <article slot="intro" class="canvas__item" data-item data-intro-item data-pattern="__intro">
          <div class="canvas__composition">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro__identity"><p class="eyebrow"><tp-mo-text-split reveal="fade up" reveal-hold stagger="0">Tweakpad UI {uiVersion}</tp-mo-text-split></p>
      <h1 class="display intro__title" id="intro-title">
        <tp-mo-text-stroke split="chars" reveal-hold stagger="45">Native UX</tp-mo-text-stroke>
        <tp-mo-text-stroke class="outline" split="chars" reveal-hold stagger="45">
          Unleashed
        </tp-mo-text-stroke>
      </h1>      <p class="intro__lede">
        <tp-mo-text-split reveal="fade up" reveal-hold stagger="0">Accessible web components, shown here in real compositions. Drag to explore, and use any of
        them: every control is live.</tp-mo-text-split>
      </p>
</div>
      <div class="intro__actions">
        <tp-button href={url('/docs')}>Get started</tp-button>
        <tp-button variant="outline" href={url('/patterns')}>All patterns</tp-button>
      </div>
      <div class="intro__install">
        <code><span aria-hidden="true">$</span> {install}</code>
        <tp-copy-button value={install} label="Copy install command"></tp-copy-button>
      </div>
    </section>
          </div>
        </article>
      </PatternCanvas>
      <Autopilot />
    </div>
  </div>
</BaseLayout>

<script>
  import { setupHomeIntro } from '../lib/home-intro';
  async function initializeIntro() {
    const tuning = import.meta.env.DEV ? await import('../lib/home-intro-tuning') : undefined;
    const intro = setupHomeIntro(tuning?.introParams());
    if (!intro || !tuning) return;
    const removeTuning = tuning.tuneIntro(intro.params, intro.replay);
    document.addEventListener('astro:before-swap', removeTuning, { once: true });
  }
  document.addEventListener('astro:page-load', initializeIntro);
  initializeIntro();
</script>

<style>
 :global(body.immersive) { overflow:hidden; }
 .home { position:fixed; inset:0; }
 .home__stage { position:absolute; inset:0; min-inline-size:0; }
 .intro { z-index:2; background:var(--tp-background); }
 .intro .eyebrow { margin-block-end:.75rem; }
 .intro__title { font-size:clamp(2.75rem,6vw,4.25rem); }
 .intro__lede { color:var(--tp-muted-foreground); font-size:.9375rem; line-height:1.6; }
 .intro__actions { --tp-primary:var(--tp-foreground); --tp-primary-foreground:var(--tp-background); flex-wrap:wrap; gap:.5rem; }
</style>

<style is:global>
.home[data-intro] { user-select: none; }
.home[data-intro] .intro { transform: translateX(-25%); opacity: 0; }
@media (width < 48rem) {
  .home[data-intro] .intro { transform: translateY(-25%); }
}
.home[data-intro] .intro > * { opacity: 0; transform: translateY(1rem); }
.home[data-intro] tp-mo-glow-border {
  --tp-mo-glow-border-intensity: 0;
}
.home[data-intro] tp-mo-glow-border::part(mo-glow-border-glow),
.home[data-intro] tp-mo-glow-border::part(mo-glow-border-bloom) {
  visibility: hidden;
}
/* The intro grid is below the cards, so its settling tail cannot hide them. */
.home[data-intro] [data-canvas] { background-image: none; }
.home[data-intro]:not([data-intro-light]) [data-fluid="dots"] { visibility: hidden; }
.home[data-intro] [data-card-layer] { opacity: 0; }
.home__stage:not([data-fluid-active]) [data-fluid="lights"] { visibility: hidden; }
.home[data-intro] .canvas__caption { opacity: 0; transition: none; }
.home[data-intro="loading"] .home__stage { visibility: hidden; }
.home[data-intro="loading"] { background: var(--tp-background); }
.home-intro-cover, .home-intro-dot-flash, .home-intro-shells { position: absolute; inset: 0; pointer-events: none; }
.home-intro-cover { z-index: 0; background: var(--tp-background); }
.home-intro-dot-flash, .home-intro-shells { z-index: 1; }
</style>

<style is:global>
.intro .eyebrow tp-mo-text-split,
.intro__lede tp-mo-text-split {
  color: inherit;
}
.intro tp-mo-text-split {
  --tp-mo-text-split-distance: 1rem;
}
/* Keep the original accent outline, using the component's own glyph drawing.
   Its normal fill phase stays transparent and its completed SVG stroke remains. */
.intro__title tp-mo-text-stroke.outline {
  color: var(--accent, var(--site-accent));
  -webkit-text-stroke: 0;
  --tp-mo-text-stroke-width: max(1px, 0.018em);
}
.intro__title tp-mo-text-stroke.outline [data-tp-animate] {
  -webkit-text-fill-color: transparent;
  -webkit-text-stroke: 0;
}
.intro__title tp-mo-text-stroke.outline [data-tp-outline] {
  opacity: 1;
}
</style>

<style is:global>
.home { display:block; }
.home__stage { position:absolute; inset:0; }
.home__stage > [data-canvas] { scroll-padding-inline-start:0; }
.home .intro { position:absolute; top:50%; left:50%; width:min(36rem,calc(100% - 2rem)); box-sizing:border-box; transform:translate(-50%,-50%); margin:0; padding:2rem; border:1px solid var(--site-line); border-radius:var(--tp-radius-2xl); display:grid; gap:1.5rem; overflow:visible; }
.home .intro__lede,.home .intro__actions,.home .intro__install { display:none; }
.home .intro[data-docked] { top:var(--site-header-height); left:0; width:100%; transform:none; border-radius:0; grid-template-columns:repeat(2,minmax(0,22rem)); justify-content:center; padding:1rem max(var(--site-gutter), calc((100% - var(--site-max)) / 2 + var(--site-gutter))); }
.home .intro[data-docked] .intro__title { zoom:.6; }
.home .intro[data-docked] .intro__lede { display:block; margin: .5rem 0 0; max-width:22rem; margin-inline-start:auto; }
.home .intro[data-docked] .intro__actions { display:flex; align-content:center; align-items:center; margin:0; }
.home .intro[data-docked] .eyebrow { grid-column:2; grid-row:1; margin:0; align-self:start; }
.home .intro[data-docked] .intro__identity { grid-column:1; grid-row:1 / 4; min-inline-size:0; text-align:right; display:flex; flex-direction:column; justify-content:space-between; }
.home .intro[data-docked] .intro__actions { grid-column:2; grid-row:2; }
.home .intro[data-docked] > :not(.intro__identity) { justify-self:start; text-align:left; }
.home .intro[data-docked] .intro__install { display:flex; grid-column:2; grid-row:3; align-items:center; justify-content:space-between; gap:.75rem; min-inline-size:0; padding:.25rem .25rem .25rem .85rem; border:1px solid var(--site-line); border-radius:var(--tp-radius-lg); background:var(--site-subtle); }
.intro__install code { min-inline-size:0; overflow:hidden; font:.8125rem var(--tp-font-mono); text-overflow:ellipsis; white-space:nowrap; }
.intro__install code span { color:var(--tp-muted-foreground); }
.intro__install tp-copy-button { flex-shrink:0; }
.home:not([data-experience="manual"]) [data-canvas] { cursor:default; }
.home[data-intro] .intro { transform:translate(-50%,-50%); }
@media(width < 48rem) {
 .home .intro[data-docked] { grid-template-columns:minmax(0,1fr); gap:.5rem; }
 .home .intro[data-docked] .intro__identity,.home .intro[data-docked] .intro__actions,.home .intro[data-docked] .eyebrow { grid-column:1; grid-row:auto; }
 .home .intro[data-docked] .intro__identity { text-align:center; }
 .home .intro[data-docked] > :not(.intro__identity) { justify-self:center; text-align:center; }
 .home .intro[data-docked] .intro__lede { font-size:.8rem; max-width:none; margin-inline-start:0; }
 .home .intro[data-docked] .eyebrow { grid-row:2; }
 .home .intro[data-docked] .intro__actions { grid-row:3; }
 .home .intro[data-docked] .intro__install { grid-column:1; grid-row:4; }
}
</style>

<style is:global>
.home[data-intro] .intro__identity { opacity:1; transform:none; }
.home[data-intro] .intro__identity > * { opacity:0; }
</style>

<style is:global>
[data-intro-item] { position:absolute; top:0; left:0; inline-size:var(--column,28rem); display:grid; justify-items:center; gap:.875rem; }
[data-intro-item] > .canvas__composition { display:flex; justify-content:center; inline-size:100%; }
.home [data-intro-item] .intro { position:relative; top:auto; left:auto; inline-size:100%; width:100%; transform:none; }
.home[data-intro] [data-intro-item] .intro { transform:none; opacity:0; }
[data-intro-item] .intro__title { font-size:clamp(2.75rem,5vw,3.5rem); }
</style>

<style is:global>
[data-intro-item]:not([data-replaced]) { z-index:2; }
.home [data-intro-item] .intro { background:var(--tp-background); text-align:center; }
.home [data-intro-item] .intro .eyebrow { justify-content:center; }
</style>
