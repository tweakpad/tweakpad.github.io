---
import PatternCanvas from '../components/PatternCanvas.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { uiVersion } from '../lib/manifest';
import { url } from '../lib/url';

const install = 'npm install @tweakpad/ui lit';
---

<BaseLayout title="Tweakpad UI" immersive>
  <div class="home">
    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow">Tweakpad UI {uiVersion}</p>
      <h1 class="display intro__title" id="intro-title">
        <tp-text-motion split="words lines" mask="lines" reveal="up" stagger="70">Interfaces,</tp-text-motion>
        <tp-text-motion class="outline" split="words lines" mask="lines" reveal="up" stagger="70">
          considered
        </tp-text-motion>
      </h1>
      <p class="intro__lede">
        Accessible web components, shown here in real compositions. Drag to explore, and use any of
        them: every control is live.
      </p>
      <div class="intro__actions">
        <tp-button href={url('/docs')}>Get started</tp-button>
        <tp-button variant="outline" href={url('/patterns')}>All patterns</tp-button>
      </div>
      <div class="install">
        <code><span aria-hidden="true">$</span> {install}</code>
        <tp-copy-button value={install} label="Copy install command"></tp-copy-button>
      </div>
    </section>
    <div class="home__stage">
      <PatternCanvas />
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.immersive) {
    overflow: hidden;
  }

  /*
   * On wide screens the intro is a sidebar column beside the canvas. Its content starts where the
   * header's does: past the space outside the centered container, then the gutter.
   */
  .home {
    --home-inset: max(0px, (100vw - var(--site-max)) / 2);

    display: grid;
    grid-template-columns: calc(var(--home-inset) + clamp(22rem, 36vw, 36rem)) minmax(0, 1fr);
    block-size: calc(100dvh - var(--site-header-height));
  }

  .home__stage {
    position: relative;
    min-inline-size: 0;
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    overflow-y: auto;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    padding-inline-start: calc(var(--home-inset) + var(--site-gutter));
    border-inline-end: 1px solid var(--site-line);
    background: var(--tp-background);
  }

  .intro .eyebrow {
    margin-block-end: 0.75rem;
  }

  .intro__title {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
  }

  .intro__lede {
    margin: 1rem 0 0;
    color: var(--tp-muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* The intro's actions stay monochrome; the library's brand color is the accent elsewhere. */
  .intro__actions {
    --tp-primary: var(--tp-foreground);
    --tp-primary-foreground: var(--tp-background);

    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: 1rem;
    padding: 0.25rem 0.25rem 0.25rem 0.85rem;
    border: 1px solid var(--site-line);
    border-radius: var(--tp-radius-lg);
    background: var(--site-subtle);
  }

  .install code {
    overflow: hidden;
    font: 0.8125rem var(--tp-font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .install code span {
    color: var(--tp-muted-foreground);
  }

  /* Narrower, the intro floats over the top of the canvas as a card. */
  @media (width < 48rem) {
    .home {
      grid-template-columns: minmax(0, 1fr);
    }

    .home > * {
      grid-area: 1 / 1;
    }

    .intro {
      z-index: 2;
      align-self: start;
      justify-self: start;
      inline-size: min(28rem, calc(100% - 2rem));
      margin: clamp(1rem, 3vw, 2rem);
      overflow: visible;
      padding: 1.5rem 1.5rem 1.25rem;
      border: 1px solid var(--site-line);
      border-radius: var(--tp-radius-2xl);
      background: color-mix(in oklab, var(--tp-background) 86%, transparent);
      backdrop-filter: blur(18px) saturate(1.3);
      box-shadow: 0 30px 80px -30px color-mix(in oklab, black 35%, transparent);
    }
  }

  @media (width < 40rem) {
    .intro {
      justify-self: stretch;
      inline-size: auto;
      margin: 0.75rem;
      padding: 1.1rem 1.1rem 1rem;
    }

    .intro__lede,
    .install {
      display: none;
    }
  }
</style>
