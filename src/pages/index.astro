---
import Autopilot from '../components/Autopilot.astro';
import FluidBackground from '../components/FluidBackground.astro';
import PatternCanvas from '../components/PatternCanvas.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { uiVersion } from '../lib/manifest';
import { url } from '../lib/url';

const install = 'npm install @tweakpad/ui lit';
---

<BaseLayout title="Tweakpad UI" immersive>
  <div class="home">
    <script is:inline data-astro-rerun>document.currentScript.parentElement.dataset.intro = 'loading'; document.currentScript.parentElement.inert = true;</script>
    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow"><tp-mo-text-split reveal="fade up" reveal-hold stagger="0">Tweakpad UI {uiVersion}</tp-mo-text-split></p>
      <h1 class="display intro__title" id="intro-title">
        <tp-mo-text-stroke split="chars" reveal-hold stagger="45">Interfaces,</tp-mo-text-stroke>
        <tp-mo-text-stroke class="outline" split="chars" reveal-hold stagger="45">
          considered
        </tp-mo-text-stroke>
      </h1>
      <p class="intro__lede">
        <tp-mo-text-split reveal="fade up" reveal-hold stagger="0">Accessible web components, shown here in real compositions. Drag to explore, and use any of
        them: every control is live.</tp-mo-text-split>
      </p>
      <div class="intro__actions">
        <tp-button href={url('/docs')}>Get started</tp-button>
        <tp-button variant="outline" href={url('/patterns')}>All patterns</tp-button>
      </div>
      <div class="install">
        <code><span aria-hidden="true">$</span> {install}</code>
        <tp-copy-button value={install} label="Copy install command"></tp-copy-button>
      </div>
    </section>
    <template data-intro-border>
      <tp-mo-segment-border trigger="none" style="--tp-mo-segment-border-color: transparent; --tp-mo-border-segment-color: var(--tp-border)">
        <div data-intro-surface></div>
        <tp-mo-border-segment draw="top-left top-left, top-left top-right" leave="top-right top-right"></tp-mo-border-segment>
        <tp-mo-border-segment draw="top-right top-right, top-right bottom-right" leave="bottom-right bottom-right"></tp-mo-border-segment>
        <tp-mo-border-segment draw="bottom-right bottom-right, bottom-right bottom-left" leave="bottom-left bottom-left"></tp-mo-border-segment>
        <tp-mo-border-segment draw="bottom-left bottom-left, bottom-left top-left" leave="top-left top-left"></tp-mo-border-segment>
      </tp-mo-segment-border>
    </template>
    <div class="home__stage">
      <FluidBackground />
      <PatternCanvas />
      <Autopilot />
    </div>
  </div>
</BaseLayout>

<script>
  import { setupHomeIntro } from '../lib/home-intro';
  async function initializeIntro() {
    const tuning = import.meta.env.DEV ? await import('../lib/home-intro-tuning') : undefined;
    const intro = setupHomeIntro(tuning?.introParams());
    if (!intro || !tuning) return;
    const removeTuning = tuning.tuneIntro(intro.params, intro.replay);
    document.addEventListener('astro:before-swap', removeTuning, { once: true });
  }
  document.addEventListener('astro:page-load', initializeIntro);
  initializeIntro();
  /*
   * Narrow, the intro floats over the top of the stage, so the canvas's covered part runs down to
   * the intro's bottom: compositions are brought into view, and the autopilot centres them, below
   * it. Scroll padding is the canvas's own, not inherited, and changes only when the intro does.
   */
  function setup() {
    const intro = document.querySelector<HTMLElement>('.home .intro:not([data-setup])');
    const canvas = document.querySelector<HTMLElement>('.home__stage [data-canvas]');
    if (!intro || !canvas) return;
    intro.dataset.setup = '';
    const narrow = matchMedia('(width < 48rem)');
    const fit = () => {
      if (!canvas.isConnected) {
        observer.disconnect();
        narrow.removeEventListener('change', fit);
        return;
      }
      const below = intro.getBoundingClientRect().bottom - canvas.getBoundingClientRect().top;
      const padding = narrow.matches ? `${Math.round(below)}px` : '';
      if (canvas.style.scrollPaddingBlockStart === padding) return;
      canvas.style.scrollPaddingBlockStart = padding;
      canvas.dispatchEvent(new Event('coveredchange'));
    };
    const observer = new ResizeObserver(fit);
    observer.observe(intro);
    narrow.addEventListener('change', fit);
  }

  document.addEventListener('astro:page-load', setup);
  setup();
</script>

<style>
  :global(body.immersive) {
    overflow: hidden;
  }

  /*
   * The home fills the viewport, under the sticky header. On wide screens the intro is a sidebar
   * column below the header; its content starts where the header's does: past the space outside
   * the centered container, then the gutter.
   */
  .home {
    --home-inset: max(0px, (100vw - var(--site-max)) / 2);
    --home-sidebar: calc(var(--home-inset) + clamp(22rem, 36vw, 36rem));

    position: fixed;
    inset: 0;
    display: grid;
    grid-template-columns: var(--home-sidebar) minmax(0, 1fr);
    grid-template-rows: var(--site-header-height) minmax(0, 1fr);
  }

  /*
   * The stage fills the whole viewport and runs on under the header and the sidebar, which are
   * translucent, rather than stopping at their edges. In it, the pattern canvas floats on the
   * fluid's lit water, under its fog, and the autopilot flies it; the sidebar sits above them all.
   */
  .home__stage {
    position: relative;
    grid-area: 1 / 1 / -1 / -1;
    min-inline-size: 0;
  }

  /* The part of the canvas the header and sidebar cover; compositions start clear of it. */
  .home__stage > :global([data-canvas]) {
    scroll-padding-block-start: var(--site-header-height);
    scroll-padding-inline-start: var(--home-sidebar);
  }

  /* The same translucent, blurred surface as the header, so the two read as one frame. */
  .intro {
    z-index: 2;
    grid-area: 2 / 1;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    overflow-y: auto;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    padding-inline-start: calc(var(--home-inset) + var(--site-gutter));
    border-inline-end: 1px solid var(--site-line);
    background: color-mix(in oklab, var(--tp-background) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  .intro .eyebrow {
    margin-block-end: 0.75rem;
  }

  .intro__title {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
  }

  .intro__lede {
    margin: 1rem 0 0;
    color: var(--tp-muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* The intro's actions stay monochrome; the library's brand color is the accent elsewhere. */
  .intro__actions {
    --tp-primary: var(--tp-foreground);
    --tp-primary-foreground: var(--tp-background);

    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: 1rem;
    padding: 0.25rem 0.25rem 0.25rem 0.85rem;
    border: 1px solid var(--site-line);
    border-radius: var(--tp-radius-lg);
    background: var(--site-subtle);
  }

  .install code {
    overflow: hidden;
    font: 0.8125rem var(--tp-font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .install code span {
    color: var(--tp-muted-foreground);
  }

  /* Narrower, the intro floats over the top of the canvas as a card. */
  @media (width < 48rem) {
    .home {
      grid-template-columns: minmax(0, 1fr);
    }

    .home__stage > :global([data-canvas]) {
      scroll-padding-inline-start: 0;
    }

    .intro {
      align-self: start;
      justify-self: start;
      inline-size: min(28rem, calc(100% - 2rem));
      margin: clamp(1rem, 3vw, 2rem);
      overflow: visible;
      padding: 1.5rem 1.5rem 1.25rem;
      border: 1px solid var(--site-line);
      border-radius: var(--tp-radius-2xl);
      background: color-mix(in oklab, var(--tp-background) 86%, transparent);
      backdrop-filter: blur(18px) saturate(1.3);
      box-shadow: 0 30px 80px -30px color-mix(in oklab, black 35%, transparent);
    }
  }

  @media (width < 40rem) {
    .intro {
      justify-self: stretch;
      inline-size: auto;
      margin: 0.75rem;
      padding: 1.1rem 1.1rem 1rem;
    }

    .intro__lede,
    .install {
      display: none;
    }
  }
</style>

<style is:global>
.home[data-intro] { user-select: none; }
.home[data-intro] .intro { transform: translateX(-25%); opacity: 0; }
@media (width < 48rem) {
  .home[data-intro] .intro { transform: translateY(-25%); }
}
.home[data-intro] .intro > * { opacity: 0; transform: translateY(1rem); }
.home[data-intro] tp-mo-glow-border {
  --tp-mo-glow-border-intensity: 0;
}
.home[data-intro] tp-mo-glow-border::part(mo-glow-border-glow),
.home[data-intro] tp-mo-glow-border::part(mo-glow-border-bloom) {
  visibility: hidden;
}
/* The intro grid is below the cards, so its settling tail cannot hide them. */
.home[data-intro] [data-canvas] { background-image: none; }
.home[data-intro] [data-fluid="dots"] { visibility: hidden; }
.home[data-intro] [data-card-layer] { opacity: 0; }
.home__stage:not([data-fluid-active]) [data-fluid="lights"] { visibility: hidden; }
.home[data-intro] .canvas__caption { opacity: 0; transition: none; }
.home[data-intro="loading"] .home__stage { visibility: hidden; }
.home[data-intro="loading"] { background: var(--tp-background); }
.home-intro-cover, .home-intro-dot-flash, .home-intro-shells { position: absolute; inset: 0; pointer-events: none; }
.home-intro-cover { z-index: 0; background: var(--tp-background); }
.home-intro-dot-flash, .home-intro-shells { z-index: 1; }
</style>

<style is:global>
.intro .eyebrow tp-mo-text-split,
.intro__lede tp-mo-text-split {
  color: inherit;
}
.intro tp-mo-text-split {
  --tp-mo-text-split-distance: 1rem;
}
/* Keep the original accent outline, using the component's own glyph drawing.
   Its normal fill phase stays transparent and its completed SVG stroke remains. */
.intro__title tp-mo-text-stroke.outline {
  color: var(--accent, var(--site-accent));
  -webkit-text-stroke: 0;
  --tp-mo-text-stroke-width: max(1px, 0.018em);
}
.intro__title tp-mo-text-stroke.outline [data-tp-animate] {
  -webkit-text-fill-color: transparent;
  -webkit-text-stroke: 0;
}
.intro__title tp-mo-text-stroke.outline [data-tp-outline] {
  opacity: 1;
}
</style>
