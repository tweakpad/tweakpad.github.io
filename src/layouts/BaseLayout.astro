---
import { ClientRouter } from 'astro:transitions';
import '@tweakpad/ui/styles.css';
// Display and code faces, self-hosted (Latin only) and bundled with the site's CSS: a third-party
// font stylesheet held up the first paint of every page.
import '@fontsource/anton/latin-400.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/site.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { url } from '../lib/url';
import { bodyFontFaces } from '../lib/fonts';
import { SITE_NAME, SITE_SUMMARY, absolute, served } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Full-viewport page with no footer, such as the home canvas. */
  immersive?: boolean;
  /** The link preview image, a site path. One image for the whole site unless a page has its own. */
  image?: string;
  /** `article` for a docs or pattern page; `website` otherwise. */
  type?: 'website' | 'article';
  /** Kept out of search results (the 404 page). */
  noindex?: boolean;
  /** Structured data (schema.org JSON-LD) for the page. */
  jsonLd?: object | object[];
  /** A footer with only the release line and no rule (the 404 page). */
  plainFooter?: boolean;
}
const {
  title,
  description = SITE_SUMMARY,
  immersive = false,
  image = '/og.png',
  type = 'website',
  noindex = false,
  jsonLd,
  plainFooter = false,
} = Astro.props;
/** A page's title names the site after it; the home page's title starts with the site's name. */
const fullTitle = title.startsWith(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const canonical = served(Astro.url.pathname);
const imageUrl = absolute(image);
const imageAlt = `${SITE_NAME}: Web Components to Tweak and Shine`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- The page background (site.css --tp-background), so the browser chrome matches it. -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />
    <link rel="alternate" type="text/plain" title="Documentation for LLMs" href={url('/llms.txt')} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    {bodyFontFaces.length > 0 && <style is:inline set:html={bodyFontFaces.join('\n')} />}
    <!--
      Links between pages swap the document in place instead of reloading it, so the docs sidebar
      (`transition:persist`) keeps its state while the article changes. The header is recreated
      so modal search state belongs to the current document.
    -->
    <ClientRouter />
    <!--
      Applies the stored theme before first paint. Same storage key and logic as the library's
      theme switcher (applyColorSchemePreference), so the header control and the page agree. The
      router replaces the <html> attributes with the next page's on every swap, so it applies
      again then.
    -->
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const value = localStorage.getItem('tp-theme');
            if (value === 'light' || value === 'dark') {
              document.documentElement.style.colorScheme = value;
              document.documentElement.dataset.theme = value;
            }
          } catch {}
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <!--
      Preview scripts that import from the library wait on this registry; Preview.astro fills it
      from the site bundle. Classic inline scripts run before any module, so it always exists first.
    -->
    <script is:inline>
      window.__tpPreviewModules = (() => {
        let resolve;
        const ready = new Promise((done) => (resolve = done));
        return { ready, resolve };
      })();
      // Preview scripts also wait for the page's library elements; src/lib/elements.ts fills it.
      window.__tpElements = (() => {
        let resolve;
        const ready = new Promise((done) => (resolve = done));
        return { ready, resolve };
      })();
    </script>
  </head>
  <body class:list={{ immersive }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!immersive && <Footer plain={plainFooter} />}
    <!-- Defines only the library elements on the page (src/lib/elements.ts), not the whole library. -->
    <script>
      import { start } from '../lib/elements';
      start();
    </script>
  </body>
</html>
