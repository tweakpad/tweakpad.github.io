    });
    const home = canvas.closest<HTMLElement>('.home');
    let idleTimer: ReturnType<typeof setTimeout> | undefined;
    const manual = () => home?.dataset.experience === 'manual';
    const activity = () => {
      if (!manual()) return;
      scene.pilot?.interrupt('wheel');
      clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        if (!home?.isConnected) return;
        home.dataset.experience = 'auto';
        world.inert = true;
        home.dispatchEvent(new Event('autoresume'));
        for (const item of items) item.hovered = item.focused = false;
        run();
      }, 5000);
    };
    const gate = (event: Event) => {
      const key = event as KeyboardEvent;
      const scroll = event.type === 'wheel' || (event.type === 'keydown' && event.target === canvas && key.key.startsWith('Arrow'));
      if (home?.dataset.experience !== 'intro' && scroll) {
        home!.dataset.experience = 'manual'; world.inert = false;
      }
      if (!manual()) {
        // Touch pointers must be tracked to recognize the existing two-finger pan.
        if ((event as PointerEvent).pointerType === 'touch' && home?.dataset.experience === 'auto') return;
        event.stopImmediatePropagation();
        if (event.cancelable) event.preventDefault();
        return;
      }
      // Moving cards can generate pointer events under a resting mouse.
      const restingMouse = event instanceof PointerEvent && event.type === 'pointermove' && event.pointerType === 'mouse' && event.movementX === 0 && event.movementY === 0;
      if (!restingMouse && !['pointerover','focusin'].includes(event.type)) activity();
    };
    for (const type of ['wheel','pointerdown','pointermove','pointerover','keydown','input','click','focusin']) canvas.addEventListener(type, gate, {capture:true,passive:false});
    world.inert = !manual();
    home?.addEventListener('introstart', () => { world.inert = true; clearTimeout(idleTimer); });
    document.addEventListener('astro:before-swap', () => clearTimeout(idleTimer), {once:true});

    const handoff = (event: Event) => {
      if(!introActive)return;
      const detail=(event as CustomEvent<{ref:CardRef;contact:[number,number];pan:[number,number]} | null>).detail;
      const target=introTarget;
      if(target) {
        packingGeneration++;extensionPending=false;realizedView=undefined;
        packedActive=true;
        packedCatalog=(naturalSizes??[]).map(c=>({...c}));
        packedPoses=[];realized.clear();packedArea=undefined;
        patchItems=introItems.filter(item=>!pendingIntroTemplates.has(item.element));patchPositions.clear();
        introItems.forEach((item,row)=>{
          const at=introPositions.get(item)!;
          packedPoses.push({card:{key:item.element.dataset.pattern!,width:item.solid.w,height:item.height,solidHeight:item.solid.h},x:at.x+item.solid.x,y:at.y+item.solid.y});
          if(!pendingIntroTemplates.has(item.element)){patchPositions.set(item,{...at});realized.set(row,item);placedOf.set(item.element,item);}
          if(item===target) {
            // Keep the actual landing node and its measured source metadata.
            // A hidden replacement used to construct another form at impact.
            const normal={...item,drawn:{...item.drawn},light:undefined};
            items[items.indexOf(item)]=normal;
            item.element.dataset.packedCard='';
          }
          item.column=-1;item.row=row;
        });
        // The measured originals are already hydrated. Once the finite column
        // grid retires, reuse these instances instead of constructing another
        // whole set of live fields during the first drag.
        resizeObserver.disconnect();
        for(const source of items){
          if(source.element===target.element)continue;
          const key=source.element.dataset.pattern!;
          const pool=recycled.get(key)??[];
          const element=source.element;
          element.dataset.packedCard='';element.style.visibility='hidden';
          element.style.transform='translate3d(-100000px,-100000px,0)';transforms.delete(element);
          const item={...source,column:-1,row:-1,drawn:{x:0,y:0},light:lightOf(element)};
          pool.push(item);recycled.set(key,pool);placedOf.delete(element);
        }
        const at=patchPositions.get(target)!;
        if(!detail) {
          const [cx,cy]=viewCentre();pan.x=cx-at.x-target.solid.x-target.solid.w/2;pan.y=cy-at.y-target.solid.y-target.solid.h/2;
        }
        if(detail)Object.assign(detail,{ref:{local:true,u:0,k:0,row:target.row},contact:[at.x+target.solid.x+target.solid.w/2,at.y+target.solid.y],pan:[pan.x,pan.y]});
      } else extras.forEach(item=>item.element.remove());
      if(packedPoses.length){
        const x=Math.min(...packedPoses.map(p=>p.x)),y=Math.min(...packedPoses.map(p=>p.y));
        patchBounds={x,y,w:Math.max(...packedPoses.map(p=>p.x+p.card.width))-x,h:Math.max(...packedPoses.map(p=>p.y+p.card.height))-y};
      }
      extras=[];
      introActive=false;
      if(introItem)introItem.style.visibility='hidden';
      introPositions.clear();introItems=[];introKey='';
      publishWorld();render();
    };
    home?.addEventListener('introhandoff',handoff);
    home?.addEventListener('introsticky',()=>{
      const header=home.querySelector<HTMLElement>('.intro');
      if(header)resizeObserver.unobserve(header);
      if(introItem)introItem.style.visibility='hidden';
      introItems=introItems.filter(item=>item.element!==introItem);
      render();
    });
    home?.addEventListener('introcomplete', () => {
      stopDrift();
      velocity.x = velocity.y = 0;
      panVelocity = [0, 0];
      run();
    });
    canvas.addEventListener('introgridreset',(event)=>{
      openingDistance=(event as CustomEvent<{distanceCards:number}>).detail.distanceCards;
      patchItems.forEach(item=>item.element.remove());patchItems=[];packedActive=false;packedPoses=[];packedCatalog=[];packedArea=undefined;realized.clear();patchPositions.clear();patchBounds=undefined;
      for(const pool of recycled.values())for(const item of pool)item.element.remove();recycled.clear();
      for(const element of originals){
        delete element.dataset.packedCard;delete element.dataset.userEdited;
        element.style.visibility='hidden';element.style.removeProperty('transform');transforms.delete(element);
        world!.append(element);
      }
      packingGeneration++;extensionPending=false;realizedView=undefined;
      introActive=true;introKey='';
      if(introItem)introItem.style.removeProperty('visibility');
      prepareIntro();
      pan.x=canvas.clientWidth/2;pan.y=canvas.clientHeight/2;
      publishWorld();render();
    });
    canvas.addEventListener('introreset', () => {
      pan.x = introActive ? canvas.clientWidth/2 : inset.left+Math.min(160,(canvas.clientWidth-inset.left)*.08);
      pan.y = introActive ? canvas.clientHeight/2 : 96+inset.top;
      velocity.x = velocity.y = 0;
      render();
    });
    document.addEventListener('astro:before-swap', () => {
      disposed = true;
      gridWorker.dispose();
      frame?.();
      clearTimeout(resumeTimer);
      clearTimeout(resizeTimer);
      resizeObserver.disconnect();
      unsubscribeScene();
      removeEventListener('resize', onResize);
      motionQuery.removeEventListener('change', motionChanged);
    }, { once: true });
    start();
  }

  // The home page arrives through the client router as well as on first load; this module runs
  // once, so the canvas is set up from the page-load event.
  document.addEventListener('astro:page-load', setup);
  setup();
</script>
