---
/**
 * An endless, pannable canvas of live pattern compositions. Every featured pattern is rendered
 * once on the server. The intro seeds measured placements; the canvas extends that same set
 * around the viewport in all directions and mounts only nearby compositions. It publishes where
 * the compositions are to its stage's scene (lib/scene.ts), for effects drawn behind and over it: a
 * card lies under those over it until it is hovered or holds focus, when it lifts and rises through
 * them. It also publishes the unwrapped world it draws from, so a pilot (the autopilot) can plan in
 * it and fly the canvas; the visitor's own input always takes the canvas back. Every card's border
 * is a Glow border, lit by the pointer or, while the pilot flies, by its trail head through the
 * water, and flaring where either strikes the card (lib/card-glow.ts). Its scroll padding marks
 * what page chrome covers; a page that changes it later dispatches `coveredchange` on it.
 */
import { DEFAULT_CANVAS_PARAMS } from '../lib/canvas-params';
import { featuredPatterns } from '../lib/content';
import { url } from '../lib/url';

const patterns = await featuredPatterns();

/**
 * Wraps a composition's visible card in a Glow border: a root Card, or the one Card a root form
 * holds. A composition of any other shape is left as it is, and its card has no glow.
 */
const glow = (example: string) => {
  const opens = [...example.matchAll(/<tp-card[\s>]/g)];
  const close = example.lastIndexOf('</tp-card>');
  if (opens.length !== 1 || close === -1) return example;
  const open = opens[0]!.index;
  const end = close + '</tp-card>'.length;
  const before = example.slice(0, open).trim();
  const after = example.slice(end).trim();
  if (!((before === '' && after === '') || (/^<form[^>]*>$/.test(before) && after === '</form>'))) return example;
  return `${example.slice(0, open)}<tp-mo-glow-border trigger="none" track-reach="${DEFAULT_CANVAS_PARAMS.glowReach}">${example.slice(open, end)}</tp-mo-glow-border>${example.slice(end)}`;
};

/**
 * The compositions are demos nobody fills in, so their text controls opt out of browser and
 * password-manager autofill, which would otherwise offer to sign in on every copy of Sign in.
 */
const demo = (example: string) =>
  glow(example.replace(/<(tp-(?:input|text-area|one-time-code-field|select))(?=[\s>])/g, '<$1 no-autofill'));
---

<div
  class="canvas"
  data-canvas
  tabindex="0"
  role="region"
  aria-label="Pattern canvas. Drag with a mouse or two fingers, scroll or use the arrow keys to explore."
>
  <div class="canvas__layer" data-card-layer>
  <div class="canvas__world" data-world>
    <slot name="intro" />
    {
      patterns.map((pattern) => (
        <article class="canvas__item" data-item data-pattern={pattern.id}>
          <div class="canvas__composition" set:html={demo(pattern.data.example)} />
          {/* The composition as served, inert: clones are filled from it, never from the live one. */}
          <template data-source set:html={demo(pattern.data.example)} />
          <a class="canvas__caption" href={url(`/patterns/${pattern.id}`)}>
            <span>{pattern.data.title}</span>
            <span class="canvas__category">{pattern.data.category}</span>
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
  </div>
</div>

<style>
  .canvas__layer {
    position: absolute;
    inset: 0;
  }

  .canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
    background-image: radial-gradient(
      color-mix(in oklab, var(--tp-foreground) 10%, transparent) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
  }

  /* The fluid draws the dots itself, as a lit surface under the water (lib/fluid/dots.wgsl). */
  :global([data-dot-surface]) > .canvas {
    background-image: none;
  }

  .canvas:focus-visible {
    outline-offset: -2px;
  }

  .canvas[data-dragging] {
    cursor: grabbing;
  }

  /* Before the script lays the canvas out (or without it), the compositions simply wrap. */
  .canvas__world {
    display: flex;
    flex-wrap: wrap;
    gap: 3.5rem;
    padding: 2rem;
  }

  .canvas[data-ready] .canvas__world {
    display: block;
    padding: 0;
  }

  .canvas__item {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    inline-size: var(--column, 28rem);
    user-select: text;
    cursor: auto;
  }

  .canvas[data-ready] .canvas__item {
    --lift: 0;

    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    will-change: transform;
  }

  /* Once risen, a card is above the fog, as the effects over the canvas sit at z-index 1. */
  .canvas__item[data-lifted] {
    z-index: 1;
  }

  .canvas__composition {
    display: flex;
    justify-content: center;
    inline-size: 100%;
  }

  /*
   * A Glow border spans the composition, as the card did, and draws over the card it holds, which
   * keeps its own width, centred. Its light fades in and out quickly, so a flare starts at once.
   */
  .canvas__composition > :global(tp-mo-glow-border),
  .canvas__composition > :global(form) > :global(tp-mo-glow-border) {
    inline-size: 100%;
    --tp-mo-glow-border-fade-duration: var(--tp-duration-fast);
  }

  .canvas__composition > :global(form) > :global(tp-mo-glow-border) { block-size:100%; }

  .canvas__composition :global(tp-mo-glow-border) > :global(tp-card) {
    margin-inline: auto;
  }

  /* The second shadow grows with the lift, as the card comes up off the surface. */
  .canvas__composition > :global(*:not(tp-mo-glow-border)),
  .canvas__composition > :global(tp-mo-glow-border) > :global(*) {
    box-shadow:
      0 24px 60px -24px color-mix(in oklab, black 22%, transparent),
      0 calc(28px * var(--lift, 0)) calc(64px * var(--lift, 0)) calc(-16px * var(--lift, 0))
        color-mix(in oklab, black calc(40% * var(--lift, 0)), transparent);
    border-radius: var(--tp-radius-xl);
  }

  .canvas__caption {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.4rem 0.3rem 0.75rem;
    border: 1px solid var(--site-line);
    border-radius: 999px;
    background: var(--tp-background);
    color: var(--tp-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 200ms var(--site-ease);
  }

  .canvas__item:hover .canvas__caption,
  .canvas__caption:focus-visible {
    opacity: 1;
  }

  .canvas__category {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--tp-muted);
    color: var(--tp-muted-foreground);
    font: 500 0.6875rem var(--tp-font-mono);
  }
  [data-mosaic-size] { contain:layout style size; }

  [data-mosaic-size] :global(tp-card)::part(card) { block-size:100%; grid-template-rows:auto minmax(0,1fr) auto; }
  [data-mosaic-size] :global(tp-card)::part(card-header) { grid-row:1; }
  [data-mosaic-size] :global(tp-card)::part(card-content) { grid-row:2; }
  [data-mosaic-size] :global(tp-card)::part(card-footer) { grid-row:3; }
</style>

<script>
  import { type CardRef } from '../lib/autopilot/model';
  import type { HomeCell } from '../lib/home-mosaic';
  import { createHomeGridWorker } from '../lib/home-grid-client';
  import { type PackedRect, type PackingSize } from '../lib/rect-packing';
  import { openingPoolCounts } from '../lib/intro-pool';
  import { introComposition } from '../lib/intro-composition';
  import { DEFAULT_INTRO_PARAMS } from '../lib/home-intro-params';
  import type { TpMoGlowBorder } from '@tweakpad/ui';
  import { createCardGlow, type GlowSource } from '../lib/card-glow';
  import { DEFAULT_CANVAS_PARAMS, type CanvasParams } from '../lib/canvas-params';
  import { assignParams, cloneParams } from '../lib/params';
  import { sceneOf, type Box, type Interrupt, type SceneRect, type WorldColumn } from '../lib/scene';

  /** Changed whenever the parameters change meaning, so an older tuning never overrides new defaults. */
  const TUNING_KEY = 'tweakpad:canvas-params:2';

  function setup() {
    const canvas = document.querySelector<HTMLElement>('[data-canvas]:not([data-setup])');
    const world = canvas?.querySelector<HTMLElement>('[data-world]');
    if (!canvas || !world) return;
    canvas.dataset.setup = '';
    // Cards and their resting fog are one composite: fade their finished
    // appearance once, rather than fading the source and its darkening overlay.
    const layer = canvas.querySelector<HTMLElement>('[data-card-layer]')!;
    const fog = canvas.parentElement?.querySelector<HTMLCanvasElement>('[data-fluid="fog"]');
    if (fog) layer.append(fog);
    // Effects behind the canvas (the fluid) read the layout from the scene of the shared stage.
    const scene = sceneOf(canvas.parentElement ?? canvas);
    const motionQuery = matchMedia('(prefers-reduced-motion: reduce)');
    let reduceMotion = motionQuery.matches;
    const params: CanvasParams = cloneParams(DEFAULT_CANVAS_PARAMS);
    const introItem = world.querySelector<HTMLElement>('[data-intro-item]');
    let openingDistance = DEFAULT_INTRO_PARAMS.impulseDistanceCards;
    let introActive = !!introItem;
    let naturalSizes: {key:string;width:number;height:number;solidHeight:number}[]|undefined;
    const profiles=new Map<string,{width:number;minHeight:number}[]>();
    const gridWorker=createHomeGridWorker();
    let introPreparation=Promise.resolve();
    let preparingCards=true;
    let introGeneration=0;
    let extensionPending=false;
    let packingGeneration=0;
    let realizedView:Box|undefined;
    let introKey = '';
    let introPeriod = 10000;
    let introTarget: Placed | undefined;
    let introItems: Placed[] = [];
    const introPositions = new Map<Placed, {x:number;y:number}>();
    let extras: Placed[] = [];
    const pendingIntroTemplates=new WeakMap<HTMLElement,number>();
    let patchItems: Placed[] = [];
    let packedActive=false;
    let packedPoses:PackedRect[]=[];
    let packedCatalog:PackingSize[]=[];
    let packedArea:Box|undefined;
    const realized=new Map<number,Placed>();
    const recycled=new Map<string,Placed[]>();
    const poolLimits=new Map<string,number>();
    let patchBounds: {x:number;y:number;w:number;h:number} | undefined;
    const patchPositions = new Map<Placed,{x:number;y:number}>();
    const originals = [...world.querySelectorAll<HTMLElement>('[data-item]:not([data-intro-item])')];
    // A composition is live components, which may already have rendered into their light DOM
    // (after a client-side navigation they have). A copy of one would carry that rendering and
    // render again on top of it, so a template item takes its composition from the inert source.
    const templates = originals.map((item) => {
      const copy = item.cloneNode(false) as HTMLElement;
      for(const child of item.children)copy.append(child===item.firstElementChild?child.cloneNode(false):child.cloneNode(true));
      const composition = copy.firstElementChild;
      const source = item.querySelector<HTMLTemplateElement>('template[data-source]');
      if (composition && source) composition.replaceChildren(source.content.cloneNode(true));
      return copy;
    });

    interface Placed {
      element: HTMLElement;
      column: number;
      /** Its place in the column, from the top. */
      row: number;
      x: number;
      y: number;
      /** The item's measured height; the lift scales about the item's centre. */
      height: number;
      /** Explicit DOM footprint width; also the lift transform origin. */
      width: number;
      radius: number;
      /** The composition's visible card, relative to the item: the item's solid. */
      solid: Box;
      /** The caption below the card, relative to the item. */
      caption: Box;
      /** How far the card has risen, 0..1, and what it is rising or sinking towards. */
      lift: number;
      hovered: boolean;
      focused: boolean;
      /** Lifted for the pilot, as if hovered. */
      featured: boolean;
      /** Where it was last drawn on the stage, before any lift. */
      drawn: { x: number; y: number };
      /** How fast it rose in the last frame, 0..1, for the effects. */
      rise: number;
      /** The card's Glow border and where the card was last drawn, for its light; none without one. */
      light: CardLight | undefined;
    }
    interface CardLight {
      glow: TpMoGlowBorder;
      x: number;
      y: number;
      w: number;
      h: number;
      scale: number;
      onStage: boolean;
    }
    let items: Placed[] = [];
    const placedOf = new Map<HTMLElement, Placed>();
    let columns = 0;
    let columnWidth = 0;
    let columnHeights: number[] = [];
    let stagger: number[] = [];
    /**
     * Each column's offset in the world, and the columns' together across it. A relayout moves
     * them, never the pan, so what is in view stays put: a pan jump would read as the layer
     * moving, and push the water.
     */
    let phases: number[] = [];
    let offsetX = 0;
    let margin = 0;
    let cardRadius = 0;
    /** The part of the canvas page chrome covers, read once per build. */
    let inset = { top: 0, left: 0 };
    let layoutVersion = 0;
    let buildCount = 0;
    const NO_SOLID: Box = { x: 0, y: 0, w: 0, h: 0 };
    /** The dot grid's tile and dot, in CSS pixels: the canvas's background, below. */
    const DOT_SPACING = 24;
    const DOT_RADIUS = 1;
    /** The lift eases in about this long, in seconds (to 95%). */
    const LIFT_TIME = 0.28;
    const LIFT_SCALE = 0.04;
    const lightOf = (element: HTMLElement): CardLight | undefined => {
      const glow = element.querySelector<TpMoGlowBorder>('.canvas__composition tp-mo-glow-border');
      if(!glow)return;
      glow.trackPoint={x:-1e6,y:-1e6};glow.trigger='none';
      return { glow, x: 0, y: 0, w: 0, h: 0, scale: 1, onStage: false };
    };
    const place = (element: HTMLElement, column: number, row: number): Placed => ({
      element,
      column,
      row,
      x: 0,
      y: 0,
      height: 0,
      width: columnWidth,
      radius: cardRadius,
      solid: NO_SOLID,
      caption: NO_SOLID,
      lift: 0,
      hovered: false,
      focused: false,
      featured: false,
      drawn: { x: 0, y: 0 },
      rise: 0,
      light: lightOf(element),
    });
    /** The solids on screen, published with every render; reused between renders. */
    const solids: SceneRect[] = [];
    const solidPool: SceneRect[] = [];

    /** The card inside an item: the composition's first element, or the card its Glow border holds. */
    const cardOf = (item: HTMLElement) => {
      const root = item.firstElementChild?.firstElementChild as HTMLElement | null | undefined;
      return root?.localName === 'tp-mo-glow-border' ? (root.firstElementChild as HTMLElement | null) : root;
    };

    /** An element's offset within an ancestor among its offset parents, as laid out, before transforms. */
    const offsetIn = (element: HTMLElement, ancestor: HTMLElement) => {
      let x = 0;
      let y = 0;
      for (let node: Element | null = element; node instanceof HTMLElement && node !== ancestor; node = node.offsetParent) {
        x += node.offsetLeft;
        y += node.offsetTop;
      }
      return [x, y] as const;
    };

    /** The light on the cards' Glow borders (lib/card-glow.ts). */
    const cardGlow = createCardGlow({ reach: params.glowReach, impact: params.glowImpact });
    let lightPointer: [number,number]=[-1e6,-1e6];
    const trackLight=(event:PointerEvent)=>{lightPointer=[event.clientX-scene.origin[0],event.clientY-scene.origin[1]];};
    const leaveLight=()=>{lightPointer=[-1e6,-1e6];};
    canvas.addEventListener('pointermove',trackLight,{passive:true});
    canvas.addEventListener('pointerleave',leaveLight);
    document.addEventListener('astro:before-swap',()=>{canvas.removeEventListener('pointermove',trackLight);canvas.removeEventListener('pointerleave',leaveLight);},{once:true});
    const NO_LIGHT: GlowSource = { kind: 'off' };
    /** The pointer lights the cards while the visitor has the canvas; the pilot's stirring head while it flies. */
    const lightSource = (): GlowSource => {
      if (canvas!.closest('.home')?.getAttribute('data-experience')==='manual')return {kind:'flow',point:lightPointer};
      if (!scene.pilot?.active) return NO_LIGHT;
      const stir = scene.stir;
      return stir && stir.strength > 0 ? { kind: 'flow', point: stir.to } : NO_LIGHT;
    };
    /** The pilot's strikes answered so far, and the bursts published for them. */
    let strikesSeen = 0;
    let bursts = 0;

    /** The placed item an event happened in, if any. */
    const itemOf = (target: EventTarget | null) =>
      target instanceof Element ? placedOf.get(target.closest<HTMLElement>('[data-item]')!) : undefined;

    const pan = { x: 0, y: 0 };
    const velocity = { x: 0, y: 0 };
    /** The idle motion, in pixels per frame: its direction follows wherever the canvas was last moved. */
    const DRIFT_SPEED = 0.28;
    const drift = { x: -0.25, y: -0.12 };
    let drifting = false;
    /** A pilot handed back to a hovering visitor: the canvas slows to a stop rather than drifting on. */
    let braking = false;
    /** The pan's velocity over the last frame, in stage pixels per second, for a pilot taking over. */
    let panVelocity: readonly [number, number] = [0, 0];
    /** The pending frame's cancellation, while one is pending. */
    let frame: (() => void) | undefined;
    let lastTick = 0;
    let resumeTimer = 0;

    /**
     * Points the drift along a movement, keeping its speed. With `smoothing` below 1 it only turns
     * part of the way, so a wandering mouse bends the drift rather than flicking it about.
     */
    const steer = (dx: number, dy: number, smoothing = 1) => {
      const length = Math.hypot(dx, dy);
      if (length < 0.01) return;
      const x = drift.x + ((dx / length) * DRIFT_SPEED - drift.x) * smoothing;
      const y = drift.y + ((dy / length) * DRIFT_SPEED - drift.y) * smoothing;
      const turned = Math.hypot(x, y) || 1;
      drift.x = (x / turned) * DRIFT_SPEED;
      drift.y = (y / turned) * DRIFT_SPEED;
    };
    /** Lets the drift run again, the way the canvas was last moved. */
    const resume = () => {
      clearTimeout(resumeTimer);
      if (reduceMotion || scene.pilot) return;
      braking = false;
      drifting = true;
      run();
    };
    /** Resumes the drift once an interaction has been quiet for a moment. */
    const resumeLater = () => {
      clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(resume, 600);
    };

    const mod = (value: number, size: number) => ((value % size) + size) % size;

    /**
     * The canvas may run under page chrome; its scroll padding marks the part that is covered, so
     * compositions start, and are brought into view, clear of it.
     */
    const covered = () => {
      const style = getComputedStyle(canvas);
      return { top: parseFloat(style.scrollPaddingTop) || 0, left: parseFloat(style.scrollPaddingLeft) || 0 };
    };

    /** The middle of the part of the stage page chrome leaves clear. */
    const viewCentre = () => {
      const [width, height] = scene.size;
      return [inset.left + (width - inset.left) / 2, inset.top + (height - inset.top) / 2] as const;
    };
    const pitch = () => columnWidth + params.gapX;
    /** Where a column, and an item, are drawn on the stage: stage = world + pan, wrapped. */
    const stageX = (column: number) =>
      mod(column * pitch() + offsetX + pan.x + pitch(), columns * pitch()) - pitch();
    const stageY = (item: Placed) =>
      mod(phases[item.column]! + item.y + pan.y + margin, columnHeights[item.column]!) - margin;

    interface Anchor {
      /** The column nearest the view's centre, and its left on the stage. */
      column: number;
      left: number;
      /** Per column, the row nearest the view's centre, and its top on the stage. */
      rows: Map<number, { row: number; top: number }>;
    }
    /**
     * Where things are drawn now, around the view's centre, so a relayout can keep them there.
     * Read from the last render, as the gaps the panel changes may already be new.
     */
    const anchor = (): Anchor | undefined => {
      if (introActive || packedActive || !items.length || !columnHeights.length) return undefined;
      const [vx, vy] = viewCentre();
      let column = 0;
      let left = 0;
      let nearest = Infinity;
      for (const item of items) {
        const distance = Math.abs(item.drawn.x + columnWidth / 2 - vx);
        if (distance < nearest) [nearest, column, left] = [distance, item.column, item.drawn.x - item.x];
      }
      const rows = new Map<number, { row: number; top: number; distance: number }>();
      for (const item of items) {
        const top = item.drawn.y;
        const distance = Math.abs(top + item.height / 2 - vy);
        const held = rows.get(item.column);
        if (!held || distance < held.distance) rows.set(item.column, { row: item.row, top, distance });
      }
      return { column, left, rows };
    };
    /** Moves the columns so that what `anchor` saw is drawn where it was. */
    const keep = (held: Anchor | undefined) => {
      if (!held) return;
      if (held.column < columns) {
        offsetX = mod(held.left - held.column * pitch() - pan.x, columns * pitch());
      }
      for (const [column, { row, top }] of held.rows) {
        const item = items.find((candidate) => candidate.column === column && candidate.row === row);
        if (item && column < columns) phases[column] = mod(top - item.y - pan.y, columnHeights[column]!);
      }
    };

    /** Column width follows the viewport: one comfortable column on a phone, many on desktop. */
    const measureColumn = () => Math.min(440, Math.max(300, canvas.clientWidth - 48));

    const originalHeights = new Map<string, number>();

    function build() {
      // Rebuilt for a new size or gap, the compositions in view stay where they were.
      const held = anchor();
      buildCount += 1;
      inset = covered();
      const nextColumn=measureColumn();if(nextColumn!==columnWidth){naturalSizes=undefined;profiles.clear();}
      columnWidth = nextColumn;
      canvas!.style.setProperty('--column', `${columnWidth}px`);
      // The one layout read of the canvas itself; the scene carries it to the effects.
      const frameBox = canvas!.getBoundingClientRect();
      scene.publish({
        origin: [frameBox.left, frameBox.top],
        size: [canvas!.clientWidth, canvas!.clientHeight],
      });
      if (!originals.length) {
        columns=1;stagger=[0];phases=[0];columnHeights=[canvas!.clientHeight+params.gapY];items=[];
        prepareIntro();publishWorld();render();return;
      }
      const firstCard = cardOf(originals[0]!);
      cardRadius = firstCard ? parseFloat(getComputedStyle(firstCard).borderTopLeftRadius) || 0 : 0;
      for (const original of originals) {
        originalHeights.set(original.dataset.pattern ?? '', original.offsetHeight);
      }
      columns = Math.max(3, Math.ceil(canvas!.clientWidth / columnWidth) + 2);
      stagger = Array.from({ length: columns }, (_, index) => (index % 2 ? 0.42 : 0) * 600);
      phases = [...stagger];
      offsetX = 0;

      // Keep the server-rendered originals; drop earlier clones.
      for (const element of world!.querySelectorAll<HTMLElement>('[data-item][data-clone]')) {
        element.remove();
      }
      const pool = [...originals];
      let next = 0;
      const take = () => {
        const source = next < pool.length ? pool[next] : undefined;
        const index = next % templates.length;
        next += 1;
        if (source) return source;
        const clone = templates[index].cloneNode(true) as HTMLElement;
        clone.dataset.clone = '';
        world!.append(clone);
        return clone;
      };

      if(introActive || packedActive){
        items=originals.map((element,i)=>place(element,i%columns,Math.floor(i/columns)));
        placedOf.clear();for(const item of [...items,...patchItems])placedOf.set(item.element,item);
        layout(held);return;
      }
      // Deal compositions round-robin so neighbouring columns differ, then top up short columns.
      items = [];
      const perColumn: HTMLElement[][] = Array.from({ length: columns }, () => []);
      const minimum = Math.max(2, Math.ceil(templates.length / columns));
      for (let row = 0; row < minimum; row += 1) {
        for (let column = 0; column < columns; column += 1) perColumn[column].push(take());
      }
      const rowsIn = Array.from({ length: columns }, () => 0);
      const add = (element: HTMLElement, column: number) => {
        items.push(place(element, column, rowsIn[column]!));
        rowsIn[column]! += 1;
      };
      perColumn.forEach((elements, column) => elements.forEach((element) => add(element, column)));
      // A column wraps seamlessly only when it is taller than the viewport plus one item. Clones
      // render asynchronously, so size them from their server-rendered original.
      const estimate = (element: HTMLElement) =>
        originalHeights.get(element.dataset.pattern ?? '') ?? element.offsetHeight;
