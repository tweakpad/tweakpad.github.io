---
/**
 * An endless, pannable canvas of live pattern compositions. Every featured pattern is rendered
 * once on the server; the client measures them and packs copies into a gapless mosaic with one
 * gutter (lib/mosaic.ts) that runs on in every direction, mounting only the cards near the view and
 * reusing their elements. On the home page the intro card takes a slot in that same mosaic, with a
 * clear gutter below it down to the card its first impulse lands on. It publishes where the
 * compositions are to its stage's scene (lib/scene.ts), for effects drawn behind and over it: a
 * card lies under those over it until it is hovered or holds focus, when it lifts and rises through
 * them. It also publishes the world it draws from, so a pilot (the autopilot) can plan in it and
 * fly the canvas; the visitor's own input always takes the canvas back. Every card's border is a
 * Glow border, lit by the pointer or, while the pilot flies, by its trail head through the water,
 * and flaring where either strikes the card (lib/card-glow.ts). Its scroll padding marks what page
 * chrome covers; a page that changes it later dispatches `coveredchange` on it.
 */
import { DEFAULT_CANVAS_PARAMS } from '../lib/canvas-params';
import { featuredPatterns } from '../lib/content';
import { url } from '../lib/url';

const patterns = await featuredPatterns();

/**
 * Wraps a composition's visible card in a Glow border: a root Card, or the one Card a root form
 * holds. A composition of any other shape is left as it is, and its card has no glow.
 */
const glow = (example: string) => {
  const opens = [...example.matchAll(/<tp-card[\s>]/g)];
  const close = example.lastIndexOf('</tp-card>');
  if (opens.length !== 1 || close === -1) return example;
  const open = opens[0]!.index;
  const end = close + '</tp-card>'.length;
  const before = example.slice(0, open).trim();
  const after = example.slice(end).trim();
  if (!((before === '' && after === '') || (/^<form[^>]*>$/.test(before) && after === '</form>'))) return example;
  return `${example.slice(0, open)}<tp-mo-glow-border trigger="none" track-reach="${DEFAULT_CANVAS_PARAMS.glowReach}">${example.slice(open, end)}</tp-mo-glow-border>${example.slice(end)}`;
};

/**
 * The compositions are demos nobody fills in, so their text controls opt out of browser and
 * password-manager autofill (the library's `no-autofill`), which would otherwise offer to sign in on
 * every copy of Sign in. Their native forms carry the same per-autofiller hints the library sets on
 * its own controls (foundation/autofill), so extensions skip the forms they scan rather than hook
 * every copy of every demo.
 */
const FORM_OPT_OUT = 'autocomplete="off" data-bwignore="true" data-1p-ignore data-lpignore="true" data-form-type="other"';
const demo = (example: string) =>
  glow(
    example
      .replace(/<(tp-(?:input|text-area|one-time-code-field|select|field))(?=[\s>])/g, '<$1 no-autofill')
      .replace(/<form(?=[\s>])/g, `<form ${FORM_OPT_OUT}`),
  );
---

<div
  class="canvas"
  data-canvas
  tabindex="0"
  role="region"
  aria-label="Pattern canvas. Drag with a mouse or two fingers, scroll or use the arrow keys to explore."
>
  <div class="canvas__layer" data-card-layer>
  <div class="canvas__world" data-world>
    <slot name="intro" />
    {
      patterns.map((pattern) => (
        <article class="canvas__item" data-item data-pattern={pattern.id} data-resize={pattern.data.resize}>
          <div class="canvas__composition" set:html={demo(pattern.data.example)} />
          {/* The composition as served, inert: clones are filled from it, never from the live one. */}
          <template data-source set:html={demo(pattern.data.example)} />
          <a class="canvas__caption" href={url(`/patterns/${pattern.id}`)}>
            <span>{pattern.data.title}</span>
            <span class="canvas__category">{pattern.data.category}</span>
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
  </div>
</div>

<style>
  .canvas__layer {
    position: absolute;
    inset: 0;
  }

  .canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
    background-image: radial-gradient(
      color-mix(in oklab, var(--tp-foreground) 10%, transparent) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
  }

  /* The fluid draws the dots itself, as a lit surface under the water (lib/fluid/dots.wgsl). */
  :global([data-dot-surface]) > .canvas {
    background-image: none;
  }

  .canvas:focus-visible {
    outline-offset: -2px;
  }

  .canvas[data-dragging] {
    cursor: grabbing;
  }

  /* Before the script lays the canvas out (or without it), the compositions simply wrap. */
  .canvas__world {
    display: flex;
    flex-wrap: wrap;
    gap: 3.5rem;
    padding: 2rem;
  }

  .canvas[data-ready] .canvas__world {
    display: block;
    padding: 0;
  }

  .canvas__item {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    inline-size: var(--column, 28rem);
    user-select: text;
    cursor: auto;
  }

  .canvas[data-ready] .canvas__item {
    --lift: 0;

    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    will-change: transform;
  }

  /* A card in reserve keeps its rendering, but is neither laid out, painted nor reachable. */
  .canvas[data-ready] .canvas__item[data-pooled] {
    content-visibility: hidden;
    visibility: hidden;
    pointer-events: none;
    will-change: auto;
  }

  /* Once risen, a card is above the fog, as the effects over the canvas sit at z-index 1. */
  .canvas__item[data-lifted] {
    z-index: 1;
  }

  .canvas__composition {
    display: flex;
    justify-content: center;
    inline-size: 100%;
  }

  /*
   * A Glow border spans the composition, as the card did, and draws over the card it holds, which
   * keeps its own width, centred. Its light fades in and out quickly, so a flare starts at once.
   */
  .canvas__composition > :global(tp-mo-glow-border),
  .canvas__composition > :global(form) > :global(tp-mo-glow-border) {
    inline-size: 100%;
    --tp-mo-glow-border-fade-duration: var(--tp-duration-fast);
  }

  .canvas__composition > :global(form) > :global(tp-mo-glow-border) { block-size: 100%; }

  .canvas__composition :global(tp-mo-glow-border) > :global(tp-card) {
    margin-inline: auto;
  }

  /* The second shadow grows with the lift, as the card comes up off the surface. */
  .canvas__composition > :global(*:not(tp-mo-glow-border)),
  .canvas__composition > :global(tp-mo-glow-border) > :global(*) {
    box-shadow:
      0 24px 60px -24px color-mix(in oklab, black 22%, transparent),
      0 calc(28px * var(--lift, 0)) calc(64px * var(--lift, 0)) calc(-16px * var(--lift, 0))
        color-mix(in oklab, black calc(40% * var(--lift, 0)), transparent);
    border-radius: var(--tp-radius-xl);
  }

  .canvas__caption {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.4rem 0.3rem 0.75rem;
    border: 1px solid var(--site-line);
    border-radius: 999px;
    background: var(--tp-background);
    color: var(--tp-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 200ms var(--site-ease);
  }

  .canvas__item:hover .canvas__caption,
  .canvas__caption:focus-visible {
    opacity: 1;
  }

  .canvas__category {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--tp-muted);
    color: var(--tp-muted-foreground);
    font: 500 0.6875rem var(--tp-font-mono);
  }

  /* A packed card has the size the mosaic gave it; what happens inside it stays inside it. */
  [data-mosaic-size] { contain: layout style size; }

  [data-mosaic-size] :global(tp-card)::part(card) { block-size: 100%; grid-template-rows: auto minmax(0, 1fr) auto; }
  [data-mosaic-size] :global(tp-card)::part(card-header) { grid-row: 1; }
  [data-mosaic-size] :global(tp-card)::part(card-content) { grid-row: 2; }
  [data-mosaic-size] :global(tp-card)::part(card-footer) { grid-row: 3; }
</style>

<script>
  import type { TpMoGlowBorder } from '@tweakpad/ui';
  import { createCardGlow, type GlowSource } from '../lib/card-glow';
  import { DEFAULT_CANVAS_PARAMS, type CanvasParams } from '../lib/canvas-params';
  import { DEFAULT_INTRO_PARAMS } from '../lib/home-intro-params';
  import { createMosaic, type Mosaic, type MosaicCard } from '../lib/mosaic';
  import { assignParams, cloneParams } from '../lib/params';
  import { sceneOf, type Box, type Interrupt, type SceneRect, type WorldLayout } from '../lib/scene';

  /** Changed whenever the parameters change meaning, so an older tuning never overrides new defaults. */
  const TUNING_KEY = 'tweakpad:canvas-params:2';

  function setup() {
    const canvas = document.querySelector<HTMLElement>('[data-canvas]:not([data-setup])');
    const world = canvas?.querySelector<HTMLElement>('[data-world]');
    if (!canvas || !world) return;
    canvas.dataset.setup = '';
    // Cards and their resting fog are one composite: fade their finished
    // appearance once, rather than fading the source and its darkening overlay.
    const layer = canvas.querySelector<HTMLElement>('[data-card-layer]')!;
    const fog = canvas.parentElement?.querySelector<HTMLCanvasElement>('[data-fluid="fog"]');
    if (fog) layer.append(fog);
    // Effects behind the canvas (the fluid) read the layout from the scene of the shared stage.
    const scene = sceneOf(canvas.parentElement ?? canvas);
    const motionQuery = matchMedia('(prefers-reduced-motion: reduce)');
    let reduceMotion = motionQuery.matches;
    const params: CanvasParams = cloneParams(DEFAULT_CANVAS_PARAMS);
    const home = canvas.closest<HTMLElement>('.home');

    /**
     * The opening card's slot (home page only), and whether the opening card shows in it. Once the
     * sticky header has taken over, the slot shows the card the mosaic packed there instead, so the
     * opening card is never seen again.
     */
    const introItem = world.querySelector<HTMLElement>('[data-intro-item]');
    let heroInSlot = !!introItem;
    let openingDistance = DEFAULT_INTRO_PARAMS.impulseDistanceCards;

    const originals = [...world.querySelectorAll<HTMLElement>('[data-item]:not([data-intro-item])')];
    const sourceOf = new Map(originals.map((element, index) => [element.dataset.pattern!, index]));
    // A composition is live components, which may already have rendered into their light DOM
    // (after a client-side navigation they have). A copy of one would carry that rendering and
    // render again on top of it, so a template item takes its composition from the inert source.
    const templates = originals.map((item) => {
      const copy = item.cloneNode(false) as HTMLElement;
      for (const child of item.children) copy.append(child === item.firstElementChild ? child.cloneNode(false) : child.cloneNode(true));
      const composition = copy.firstElementChild;
      const source = item.querySelector<HTMLTemplateElement>('template[data-source]');
      if (composition && source) composition.replaceChildren(source.content.cloneNode(true));
      return copy;
    });

    interface CardLight {
      glow: TpMoGlowBorder;
      x: number;
      y: number;
      w: number;
      h: number;
      scale: number;
      onStage: boolean;
    }
    /** A card on the canvas: an element showing one copy of one card of the world. */
    interface Placed {
      element: HTMLElement;
      /** The card in the world, and which copy of the period. */
      index: number;
      k: number;
      /** Its footprint in the world, before the copy's offset. */
      x: number;
      y: number;
      w: number;
      h: number;
      radius: number;
      /** The composition's visible card, relative to the footprint: the item's solid. */
      solid: Box;
      /** The caption below the card, relative to the footprint. */
      caption: Box;
      /** How far the card has risen, 0..1, and what it is rising or sinking towards. */
      lift: number;
      hovered: boolean;
      focused: boolean;
      /** Lifted for the pilot, as if hovered. */
      featured: boolean;
      /** Where it was last drawn on the stage, before any lift. */
      drawn: { x: number; y: number };
      /** How fast it rose in the last frame, 0..1, for the effects. */
      rise: number;
      /** The card's Glow border and where the card was last drawn, for its light; none without one. */
      light: CardLight | undefined;
    }

    const NO_SOLID: Box = { x: 0, y: 0, w: 0, h: 0 };
    /** The dot grid's tile and dot, in CSS pixels: the canvas's background, below. */
    const DOT_SPACING = 24;
    const DOT_RADIUS = 1;
    /** The lift eases in about this long, in seconds (to 95%). */
    const LIFT_TIME = 0.28;
    const LIFT_SCALE = 0.04;
    const OFF = { x: -1e6, y: -1e6 };
    const lightOf = (element: HTMLElement): CardLight | undefined => {
      const glow = element.querySelector<TpMoGlowBorder>('.canvas__composition tp-mo-glow-border');
      if (!glow) return undefined;
      glow.trackPoint = OFF;
      glow.trigger = 'none';
      return { glow, x: 0, y: 0, w: 0, h: 0, scale: 1, onStage: false };
    };

    /** The card inside an item: the composition's first element, or the card its Glow border holds. */
    const cardOf = (item: HTMLElement) => {
      const root = item.firstElementChild?.firstElementChild as HTMLElement | null | undefined;
      return root?.localName === 'tp-mo-glow-border' ? (root.firstElementChild as HTMLElement | null) : root;
    };

    /** The light on the cards' Glow borders (lib/card-glow.ts). */
    const cardGlow = createCardGlow({ reach: params.glowReach, impact: params.glowImpact });
    let lightPointer: [number, number] = [-1e6, -1e6];
    const trackLight = (event: PointerEvent) => { lightPointer = [event.clientX - scene.origin[0], event.clientY - scene.origin[1]]; };
    const leaveLight = () => { lightPointer = [-1e6, -1e6]; };
    canvas.addEventListener('pointermove', trackLight, { passive: true });
    canvas.addEventListener('pointerleave', leaveLight);
    const NO_LIGHT: GlowSource = { kind: 'off' };
    /** The pointer lights the cards while the visitor has the canvas; the pilot's stirring head while it flies. */
    const lightSource = (): GlowSource => {
      if (home?.dataset.experience === 'manual') return { kind: 'flow', point: lightPointer };
      if (!scene.pilot?.active) return NO_LIGHT;
      const stir = scene.stir;
      return stir && stir.strength > 0 ? { kind: 'flow', point: stir.to } : NO_LIGHT;
    };
    /** The pilot's strikes answered so far, and the bursts published for them. */
    let strikesSeen = 0;
    let bursts = 0;

    const pan = { x: 0, y: 0 };
    const velocity = { x: 0, y: 0 };
    /** The idle motion, in pixels per frame: its direction follows wherever the canvas was last moved. */
    const DRIFT_SPEED = 0.28;
    const drift = { x: -0.25, y: -0.12 };
    let drifting = false;
    /** A pilot handed back to a hovering visitor: the canvas slows to a stop rather than drifting on. */
    let braking = false;
    /** The pan's velocity over the last frame, in stage pixels per second, for a pilot taking over. */
    let panVelocity: readonly [number, number] = [0, 0];
    /** The pending frame's cancellation, while one is pending. */
    let frame: (() => void) | undefined;
    let lastTick = 0;
    let resumeTimer = 0;
    let disposed = false;

    /**
     * Points the drift along a movement, keeping its speed. With `smoothing` below 1 it only turns
     * part of the way, so a wandering mouse bends the drift rather than flicking it about.
     */
    const steer = (dx: number, dy: number, smoothing = 1) => {
      const length = Math.hypot(dx, dy);
      if (length < 0.01) return;
      const x = drift.x + ((dx / length) * DRIFT_SPEED - drift.x) * smoothing;
      const y = drift.y + ((dy / length) * DRIFT_SPEED - drift.y) * smoothing;
      const turned = Math.hypot(x, y) || 1;
      drift.x = (x / turned) * DRIFT_SPEED;
      drift.y = (y / turned) * DRIFT_SPEED;
    };
    /** Lets the drift run again, the way the canvas was last moved. */
    const resume = () => {
      clearTimeout(resumeTimer);
      if (reduceMotion || scene.pilot) return;
      braking = false;
      drifting = true;
      run();
    };
    /** Resumes the drift once an interaction has been quiet for a moment. */
    const resumeLater = () => {
      clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(resume, 600);
    };

    /**
     * The canvas may run under page chrome; its scroll padding marks the part that is covered, so
     * compositions start, and are brought into view, clear of it.
     */
    const covered = () => {
      const style = getComputedStyle(canvas);
      return { top: parseFloat(style.scrollPaddingTop) || 0, left: parseFloat(style.scrollPaddingLeft) || 0 };
    };
    /** The part of the canvas page chrome covers. */
    let inset = { top: 0, left: 0 };

    // ---- The world: measured cards, packed. ----

    /** The cards as measured, by pattern: their size ranges, and their corner radius. */
    const radii = new Map<string, number>();
    let heroRadius = 0;
    let mosaic: Mosaic | undefined;
    let layout: WorldLayout | undefined;
    let buildCount = 0;

    /** Column width follows the viewport: one comfortable card on a phone, a typical one on desktop. */
    const measureColumn = () => Math.min(440, Math.max(300, canvas.clientWidth - 48));

    /**
     * A composition's own inline sizes (a demo's `style="inline-size:min(100%, 24rem)"`), kept from
     * before the canvas first sizes it, so measuring again finds the composition as authored.
     */
    const authored = new WeakMap<HTMLElement, { inline: string; block: string }>();
    const own = (element: HTMLElement | null | undefined) => {
      if (element && !authored.has(element)) authored.set(element, { inline: element.style.inlineSize, block: element.style.blockSize });
      return element;
    };
    const restore = (element: HTMLElement | null | undefined) => {
      const sizes = element && authored.get(element);
      if (!element || !sizes) return;
      element.style.inlineSize = sizes.inline;
      element.style.blockSize = sizes.block;
    };
    /** The card's parts the canvas sizes: the composition's root and, in a form, its card. */
    const partsOf = (element: HTMLElement) => {
      const root = own(cardOf(element));
      const card = root?.localName === 'form' ? own(root.querySelector<HTMLElement>('tp-card')) : null;
      return { root, card };
    };

    /** Clears what the mosaic set on an element, so it lays out as authored again. */
    const unsize = (element: HTMLElement) => {
      delete element.dataset.mosaicSize;
      element.style.removeProperty('inline-size');
      element.style.removeProperty('block-size');
      const { root, card } = partsOf(element);
      restore(root);
      restore(card);
      sizes.delete(element);
    };

    /**
     * Measures every pattern once, from its server-rendered original as authored: its card's natural
     * size, its minimum height across its range (seven widths, refined where text wraps), and its
     * caption.
     */
    const measure = (): MosaicCard[] => {
      const column = measureColumn();
      canvas.style.setProperty('--column', `${column}px`);
      for (const element of originals) {
        delete element.dataset.pooled;
        unsize(element);
      }
      const probes = originals.map((element) => {
        const root = cardOf(element)!;
        const inner = root.localName === 'form' ? root.querySelector<HTMLElement>('tp-card') : null;
        const caption = element.querySelector<HTMLElement>('.canvas__caption');
        const resize = Math.min(0.5, Math.max(0, Number(element.dataset.resize ?? 15) / 100));
        return { element, root, inner, caption, resize, width: 0, height: 0, floor: [] as { width: number; minHeight: number }[] };
      });
      for (const probe of probes) {
        probe.width = probe.root.offsetWidth;
        probe.height = probe.root.offsetHeight;
      }
      // Seven widths across the range, each one batched write then read for every pattern: text
      // wraps in steps, and the mosaic takes the taller of the two samples around any width.
      for (const factor of [-1, -2 / 3, -1 / 3, 0, 1 / 3, 2 / 3, 1]) {
        for (const p of probes) {
          p.root.style.inlineSize = `${p.width * (1 + factor * p.resize)}px`;
          p.root.style.blockSize = 'auto';
          if (p.inner) p.inner.style.blockSize = 'auto';
        }
        for (const p of probes) p.floor.push({ width: p.width * (1 + factor * p.resize), minHeight: Math.ceil(p.root.getBoundingClientRect().height) });
      }
      // Where the height steps between two samples, the content wraps somewhere between them:
      // bisect there, so the taller sample only holds over a pixel or two, not a whole interval.
      for (let round = 0; round < 6; round++) {
        const probing = probes.flatMap((p) => {
          const sorted = p.floor.sort((a, b) => a.width - b.width);
          let gap: number | undefined;
          for (let i = 1; i < sorted.length; i++) {
            const span = sorted[i]!.width - sorted[i - 1]!.width;
            if (sorted[i]!.minHeight !== sorted[i - 1]!.minHeight && span > 1 && (gap === undefined || span > gap)) gap = (sorted[i]!.width + sorted[i - 1]!.width) / 2;
          }
          return gap === undefined ? [] : [{ p, width: gap }];
        });
        if (!probing.length) break;
        for (const { p, width } of probing) p.root.style.inlineSize = `${width}px`;
        for (const { p, width } of probing) p.floor.push({ width, minHeight: Math.ceil(p.root.getBoundingClientRect().height) });
      }
      const gap = parseFloat(getComputedStyle(originals[0]!).rowGap) || 0;
      const cards = probes.map((p): MosaicCard => {
        const native = p.inner ?? p.root;
        const boundary = native.shadowRoot?.querySelector<HTMLElement>('[part~="card"]') ?? native;
        radii.set(p.element.dataset.pattern!, parseFloat(getComputedStyle(boundary).borderTopLeftRadius) || 0);
        return {
          key: p.element.dataset.pattern!,
          width: { min: p.width * (1 - p.resize), pref: p.width, max: p.width * (1 + p.resize) },
          height: { min: p.height * (1 - p.resize), pref: p.height, max: p.height * (1 + p.resize) },
          floor: p.floor,
          caption: { gap, width: p.caption?.offsetWidth ?? 0, height: p.caption?.offsetHeight ?? 0 },
        };
      });
      // Every original is in reserve again (unmountAll put it there); mounting takes it back out.
      for (const p of probes) {
        unsize(p.element);
        p.element.dataset.pooled = '';
      }
      return cards;
    };

    /** Packs the world again: for a new viewport, new gaps, or the intro starting over. */
    function build() {
      buildCount += 1;
      inset = covered();
      // The one layout read of the canvas itself; the scene carries it to the effects.
      const frameBox = canvas!.getBoundingClientRect();
      scene.publish({ origin: [frameBox.left, frameBox.top], size: [canvas!.clientWidth, canvas!.clientHeight], inset: [inset.left, inset.top] });
      unmountAll();
      if (!originals.length) return;
      const catalog = measure();
      const hero = introItem?.querySelector<HTMLElement>('.intro-card');
      let heroSize: { width: number; height: number } | undefined;
      if (introItem && !heroInSlot) introItem.dataset.pooled = '';
      if (heroInSlot && introItem && hero) {
        delete introItem.dataset.pooled;
        unsize(introItem);
        heroSize = { width: hero.offsetWidth, height: hero.offsetHeight };
        heroRadius = parseFloat(getComputedStyle(hero).borderTopLeftRadius) || 0;
      }
      const footprints = catalog.map((card) => card.height.pref + card.caption.gap + card.caption.height).sort((a, b) => a - b);
      const median = footprints[Math.floor(footprints.length / 2)]!;
      const widths = catalog.map((card) => card.width.pref).sort((a, b) => a - b);
      mosaic = createMosaic(catalog, {
        gap: [params.gapX, params.gapY],
        period: Math.max(2400, canvas!.clientWidth * 3),
        seed: 271828,
        hero: heroSize,
        landingDepth: Math.max(canvas!.clientHeight, (median + params.gapY) * openingDistance),
      });
      const opening = heroSize && mosaic.hero !== undefined && mosaic.landing !== undefined ? { hero: mosaic.hero, landing: mosaic.landing } : undefined;
      layout = {
        build: buildCount,
        gap: [params.gapX, params.gapY],
        period: mosaic.period,
        cardWidth: widths[Math.floor(widths.length / 2)]!,
        tallest: Math.max(...catalog.map((card) => Math.max(card.height.max, ...(card.floor ?? []).map((f) => f.minHeight)) + card.caption.gap + card.caption.height)),
        items: mosaic.items,
        query: mosaic.query,
        opening,
      };
      scene.publish({ layout });
    }

    // ---- Mounting: only the cards near the view have elements, reused from a pool per pattern. ----

    /** Mounted cards, by `index:k`. */
    const mounted = new Map<string, Placed>();
    const placedOf = new Map<HTMLElement, Placed>();
    /** Elements in reserve, per pattern, with their lights. */
    const pools = new Map<string, { element: HTMLElement; light: CardLight | undefined }[]>();
    /** The size last written on an element, so a reused one is only resized when it must be. */
    const sizes = new WeakMap<HTMLElement, { w: number; h: number; body: number }>();
    const transforms = new WeakMap<HTMLElement, string>();

    /**
     * Puts an element in reserve, out of the document: it keeps its rendering, but nothing watching
     * the page (components' own observers, password managers scanning forms) sees it until reused.
     * The server-rendered originals stay, hidden: they are what every pattern is measured from, and
     * a component attached again renders again, which a measurement in the same task would not see.
     */
    const measured = new Set(originals);
    const pool = (element: HTMLElement, light: CardLight | undefined) => {
      element.dataset.pooled = '';
      transforms.delete(element);
      if (!measured.has(element)) element.remove();
      if (light) {
        light.onStage = false;
        light.glow.trackPoint = OFF;
        light.glow.trigger = 'none';
      }
      const pattern = element.dataset.pattern!;
      const list = pools.get(pattern);
      if (list) list.push({ element, light });
      else pools.set(pattern, [{ element, light }]);
    };

    const unmount = (key: string, placed: Placed) => {
      mounted.delete(key);
      placedOf.delete(placed.element);
      placed.element.style.removeProperty('--lift');
      delete placed.element.dataset.lifted;
      if (placed.element === introItem) {
        introItem.dataset.pooled = '';
        return;
      }
      // A demo someone has typed into is theirs: never shown again as another copy. An original
      // stays, out of sight, as the pattern's measure.
      if (placed.element.hasAttribute('data-user-edited')) {
        if (measured.has(placed.element)) placed.element.dataset.pooled = '';
        else placed.element.remove();
        return;
      }
      pool(placed.element, placed.light);
    };

    function unmountAll() {
      for (const [key, placed] of mounted) unmount(key, placed);
      // Originals not yet placed (on the first build) go to the pool, out of the way.
      for (const element of originals) {
        if (element.hasAttribute('data-pooled') || element.hasAttribute('data-user-edited')) continue;
        pool(element, lightOf(element));
      }
    }

    /** A new element for `pattern`, from its inert source. */
    const construct = (pattern: string) => {
      const element = templates[sourceOf.get(pattern)!]!.cloneNode(true) as HTMLElement;
      element.dataset.clone = '';
      element.dataset.pooled = '';
      world!.append(element);
      return { element, light: lightOf(element) };
    };

    /** Gives an element the size its card was packed at; writes only what changed. */
    const size = (element: HTMLElement, w: number, h: number, body: number) => {
      const last = sizes.get(element);
      if (last && last.w === w && last.h === h && last.body === body) return;
      sizes.set(element, { w, h, body });
      element.dataset.mosaicSize = '';
      element.style.inlineSize = `${w}px`;
      element.style.blockSize = `${h}px`;
      if (element === introItem) return;
      const { root, card } = partsOf(element);
      if (!root) return;
      root.style.inlineSize = `${w}px`;
      root.style.blockSize = `${body}px`;
      if (card) card.style.blockSize = '100%';
    };

    const mount = (index: number, k: number, budget: { fresh: number; any: number }): boolean => {
      const item = mosaic!.items[index]!;
      const hero = heroInSlot && k === 0 && index === mosaic!.hero && introItem;
      let taken: { element: HTMLElement; light: CardLight | undefined } | undefined;
      if (hero) {
        delete introItem.dataset.pooled;
        taken = { element: introItem, light: undefined };
      } else {
        if (budget.any <= 0) return false;
        taken = pools.get(item.pattern)?.pop();
        if (!taken) {
          if (budget.fresh <= 0) return false;
          budget.fresh -= 1;
          taken = construct(item.pattern);
        }
        budget.any -= 1;
        delete taken.element.dataset.pooled;
        if (!taken.element.isConnected) world!.append(taken.element);
      }
      const { element, light } = taken;
      if (light) light.glow.trackReach = params.glowReach;
      const placed: Placed = {
        element,
        index,
        k,
        x: item.x,
        y: item.y,
        w: item.w,
        h: item.h,
        radius: hero ? heroRadius : (radii.get(item.pattern) ?? 0),
        solid: hero ? { x: 0, y: 0, w: item.w, h: item.h } : item.card,
        caption: hero ? NO_SOLID : item.caption,
        lift: 0,
        hovered: false,
        focused: false,
        featured: false,
        drawn: { x: 0, y: 0 },
        rise: 0,
        light,
      };
      size(element, item.w, item.h, item.card.h);
      mounted.set(`${index}:${k}`, placed);
      placedOf.set(element, placed);
      return true;
    };

    /**
     * Elements made ahead of need while nothing else runs: enough of each pattern for the most
     * cards of it shown at once anywhere along `views`.
     */
    let idle = 0;
    const prepare = (views: readonly Box[]) => {
      if (!mosaic || idle || typeof requestIdleCallback !== 'function') return;
      const wanted = new Map<string, number>();
      for (const view of views) {
        const here = new Map<string, number>();
        mosaic.query(view, (index) => {
          const pattern = mosaic!.items[index]!.pattern;
          here.set(pattern, (here.get(pattern) ?? 0) + 1);
        });
        for (const [pattern, count] of here) wanted.set(pattern, Math.max(wanted.get(pattern) ?? 0, count));
      }
      // Elements that exist already, shown or in reserve, count towards it.
      for (const placed of mounted.values()) {
        const pattern = placed.element.dataset.pattern!;
        if (wanted.has(pattern)) wanted.set(pattern, wanted.get(pattern)! - 1);
      }
      for (const [pattern, list] of pools) if (wanted.has(pattern)) wanted.set(pattern, wanted.get(pattern)! - list.length);
      const step = (deadline: IdleDeadline) => {
        idle = 0;
        if (disposed) return;
        for (const [pattern, count] of wanted) {
          if (count <= 0) continue;
          // A new card costs a few milliseconds even on a fast machine; only a long idle period takes one.
          if (deadline.timeRemaining() < 12) {
            idle = requestIdleCallback(step);
            return;
          }
          const made = construct(pattern);
          pool(made.element, made.light);
          wanted.set(pattern, count - 1);
        }
        if ([...wanted.values()].some((count) => count > 0)) idle = requestIdleCallback(step);
      };
      idle = requestIdleCallback(step);
    };

    /**
     * Mounts the cards near the view and lets the rest go. Cards on the stage mount at once; those
     * just off it take pooled elements freely, but build at most one new element a frame.
     */
    let pending = false;
    const sync = (stageWidth: number, stageHeight: number) => {
      if (!mosaic) return;
      const view = { x: -pan.x, y: -pan.y, w: stageWidth, h: stageHeight };
      const guard = Math.max(layout!.cardWidth, 240);
      // Look further ahead in the direction of travel.
      const ahead = (v: number) => Math.max(-stageWidth, Math.min(stageWidth, -v * 0.35));
      const ax = ahead(panVelocity[0]);
      const ay = ahead(panVelocity[1]);
      const area = {
        x: view.x - guard + Math.min(0, ax),
        y: view.y - guard + Math.min(0, ay),
        w: view.w + guard * 2 + Math.abs(ax),
        h: view.h + guard * 2 + Math.abs(ay),
      };
      const wanted = new Set<string>();
      const missing: [number, number, boolean][] = [];
      mosaic.query(area, (index, k) => {
        const key = `${index}:${k}`;
        wanted.add(key);
        if (mounted.has(key)) return;
        const item = mosaic!.items[index]!;
        const x = item.x + k * mosaic!.period;
        const visible = x < view.x + view.w && x + item.w > view.x && item.y < view.y + view.h && item.y + item.h > view.y;
        missing.push([index, k, visible]);
      });
      for (const [key, placed] of mounted) {
        if (wanted.has(key) || placed.focused || placed.element.contains(document.activeElement)) continue;
        unmount(key, placed);
      }
      // Cards just off the stage come in a couple a frame, so their first layout is spread out;
      // while the intro plays they come only from the pool, which fills in idle time.
      const playing = !!home?.hasAttribute('data-intro');
      const nearby = { fresh: playing ? 0 : 1, any: playing ? Infinity : 2 };
      const unlimited = { fresh: Infinity, any: Infinity };
      pending = false;
      for (const [index, k, visible] of missing) if (!mount(index, k, visible ? unlimited : nearby) && !playing) pending = true;
    };

    // ---- Drawing ----

    /** The solids on screen, published with every render; reused between renders. */
    const solids: SceneRect[] = [];
    const solidPool: SceneRect[] = [];

    function render() {
      const [stageWidth, stageHeight] = scene.size;
      const [originX, originY] = scene.origin;
      const pixelRatio = devicePixelRatio || 1;
      // Snap to device pixels in the viewport, not just in the stage, so text and borders stay crisp.
      // Publish the same snapped positions below so the fog follows their edges.
      const snap = (value: number, origin: number) => Math.round((value + origin) * pixelRatio) / pixelRatio - origin;
      const device = (value: number) => Math.round(value * pixelRatio) / pixelRatio;
      sync(stageWidth, stageHeight);
      solids.length = 0;
      const period = mosaic?.period ?? 0;
      // Each card is placed on its own: the world must not become a stacking context, or the cards
      // could not rise above the fog (z-index 1 in the card layer) when lifted, nor the intro card
      // stay above it.
      const px = snap(pan.x, originX);
      const py = snap(pan.y, originY);
      for (const item of mounted.values()) {
        const x = px + device(item.x + item.k * period);
        const y = py + device(item.y);
        item.drawn.x = x;
        item.drawn.y = y;
        const scale = 1 + LIFT_SCALE * item.lift;
        const transform = `translate3d(${x}px, ${y}px, 0) scale(${scale})`;
        if (transforms.get(item.element) !== transform) {
          item.element.style.transform = transform;
          transforms.set(item.element, transform);
        }
        // The same numbers place the card's solid, scaled about the item's centre like the item;
        // only cards on the stage are published.
        const { solid } = item;
        const cx = x + item.w / 2;
        const cy = y + item.h / 2;
        const sx = cx + (x + solid.x - cx) * scale;
        const sy = cy + (y + solid.y - cy) * scale;
        const sw = solid.w * scale;
        const sh = solid.h * scale;
        const onStage = solid.w > 0 && sx < stageWidth && sy < stageHeight && sx + sw > 0 && sy + sh > 0;
        if (onStage) {
          const index = solids.length;
          const rect = solidPool[index] ?? (solidPool[index] = { x: 0, y: 0, w: 0, h: 0, r: 0, lift: 0, rise: 0 });
          rect.x = sx; rect.y = sy; rect.w = sw; rect.h = sh;
          rect.r = item.radius * scale; rect.lift = item.lift; rect.rise = item.rise;
          solids.push(rect);
        }
        const { light } = item;
        if (light) {
          light.x = sx;
          light.y = sy;
          light.w = sw;
          light.h = sh;
          light.scale = scale;
          light.onStage = onStage;
        }
      }
      // The dot grid moves with the pan, slower, as if behind the cards. Not through custom
      // properties: a background change repaints the whole canvas, so it is set only when it moves.
      const dotOffset = [
        ((pan.x * params.parallax) % DOT_SPACING + DOT_SPACING) % DOT_SPACING,
        ((pan.y * params.parallax) % DOT_SPACING + DOT_SPACING) % DOT_SPACING,
      ] as const;
      scene.publish({
        pan: [pan.x, pan.y],
        rects: solids,
        dots: { offset: dotOffset, spacing: DOT_SPACING, radius: DOT_RADIUS },
      });
      cardGlow.update(performance.now(), lights(), home?.hasAttribute('data-intro') ? NO_LIGHT : lightSource(), scene.origin);
      if (pending) run();
    }

    function* lights() {
      for (const item of mounted.values()) if (item.light) yield item.light;
    }

    /** A struck card's light starts on the point of entry and flares there (lib/card-glow.ts). */
    function strike(item: Placed, offset: readonly [number, number], normal: readonly [number, number]) {
      if (item.light && !reduceMotion) cardGlow.impact(item.light.glow, offset, normal, performance.now());
    }

    /** Eases every card's lift towards hovered, focused or featured; true while any is still moving. */
    function animateLifts(dt: number) {
      let moving = false;
      const featured = scene.pilot?.featured;
      for (const item of mounted.values()) {
        item.featured = !!featured && item.index === featured.item;
        const target = item.hovered || item.focused || item.featured ? 1 : 0;
        const previous = item.lift;
        if (reduceMotion || Math.abs(target - previous) < 0.004) {
          item.lift = target;
        } else {
          // An exponential approach: LIFT_TIME is three time constants.
          item.lift = target + (previous - target) * Math.exp((-3 * dt) / LIFT_TIME);
          moving = true;
        }
        if (item.lift !== previous) {
          item.rise = dt > 0 ? Math.min(1, (Math.max(0, item.lift - previous) * LIFT_TIME) / (3 * dt)) : 0;
          item.element.style.setProperty('--lift', item.lift.toFixed(3));
          if (item.lift > 0.98) item.element.dataset.lifted = '';
          else delete item.element.dataset.lifted;
        } else {
          item.rise = 0;
        }
      }
      return moving;
    }

    function tick(now: number) {
      frame = undefined;
      // The page may have been swapped out under the canvas; nothing is left to animate then.
      if (!canvas!.isConnected || disposed) return;
      if (home?.hasAttribute('data-intro')) { render(); lastTick = 0; return; }
      const dt = lastTick ? Math.min(0.1, (now - lastTick) / 1000) : 1 / 60;
      lastTick = now;
      const lifting = animateLifts(dt);
      const before = [pan.x, pan.y];
      const pilot = scene.pilot;
      let panning = true;
      // A pilot flies the canvas in place of its own motion; it keeps time while it holds off.
      if (home?.dataset.experience === 'manual') pilot?.interrupt('wheel');
      const flown = pilot?.update(dt, [pan.x, pan.y], panVelocity);
      // The pilot's head struck a card: every copy of that card in view answers at the same point,
      // and the floor under the one on the stage bursts with light there, once it is drawn.
      const struck = pilot?.strike;
      let burst: { item: Placed; offset: readonly [number, number] } | undefined;
      if (struck && struck.count !== strikesSeen) {
        strikesSeen = struck.count;
        for (const item of mounted.values()) {
          if (item.index !== struck.item) continue;
          strike(item, struck.offset, struck.normal);
          if (!burst && item.light?.onStage) burst = { item, offset: struck.offset };
        }
      }
      if (flown) {
        [pan.x, pan.y] = flown;
      } else if (drifting && !pilot) {
        pan.x += drift.x;
        pan.y += drift.y;
      } else if (drag || touchDrag) {
        // Pointer events already moved the canvas; inertia starts on release.
        panning = false;
      } else if (Math.abs(velocity.x) > 0.05 || Math.abs(velocity.y) > 0.05) {
        pan.x += velocity.x;
        pan.y += velocity.y;
        const retain = braking ? 0.8 : 0.94;
        velocity.x *= retain;
        velocity.y *= retain;
        // A thrown canvas slows down into the drift, which carries on the same way.
        if (!reduceMotion && !braking && !pilot && Math.hypot(velocity.x, velocity.y) <= DRIFT_SPEED) {
          steer(velocity.x, velocity.y);
          drifting = true;
        }
      } else {
        panning = false;
      }
      panVelocity = [(pan.x - before[0]!) / dt, (pan.y - before[1]!) / dt];
      render();
      const light = burst?.item.light;
      if (burst && light && !reduceMotion) {
        bursts += 1;
        scene.publish({
          burst: {
            at: [light.x + burst.offset[0] * light.scale, light.y + burst.offset[1] * light.scale],
            pan: [pan.x, pan.y],
            count: bursts,
          },
        });
      }
      // A pilot keeps time even while it holds off, so the canvas keeps its frames.
      if (panning || lifting || pilot) frame = scene.requestFrame(tick, 'layout');
      else lastTick = 0;
    }
    const run = () => {
      if (!disposed && !frame) frame = scene.requestFrame(tick, 'layout');
    };
    const visibilityChanged = () => { lastTick = 0; };
    document.addEventListener('visibilitychange', visibilityChanged);

    /** The middle of the part of the stage page chrome leaves clear. */
    const viewCentre = () => {
      const [width, height] = scene.size;
      return [inset.left + (width - inset.left) / 2, inset.top + (height - inset.top) / 2] as const;
    };
    /** Puts the world's origin, the intro card's centre, in the middle of the stage. */
    const centre = () => {
      pan.x = canvas.clientWidth / 2;
      pan.y = canvas.clientHeight / 2;
      velocity.x = velocity.y = 0;
    };

    // ---- Input ----

    /** The placed item an event happened in, if any. */
    const itemOf = (target: EventTarget | null) =>
      target instanceof Element ? placedOf.get(target.closest<HTMLElement>('[data-item]')!) : undefined;

    /**
     * The visitor takes the canvas back from a pilot, if one is flying it; the pilot holds off
     * until they have been idle a while. A hovering visitor is reading a card, so the canvas slows
     * to a stop under the pointer; any other input stops it at once.
     */
    const takeOver = (reason: Interrupt) => {
      if (home?.dataset.experience !== 'manual') return;
      const pilot = scene.pilot;
      if (!pilot) return;
      const flying = pilot.active;
      pilot.interrupt(reason);
      if (!flying) return;
      clearTimeout(resumeTimer);
      drifting = false;
      if (reason === 'hover') {
        // The canvas's own velocity is in pixels per frame.
        velocity.x = panVelocity[0] / 60;
        velocity.y = panVelocity[1] / 60;
        braking = true;
      } else {
        velocity.x = velocity.y = 0;
      }
      run();
    };

    /**
     * When the mouse last moved. Browsers report hovering again when content moves under a still
     * pointer, so only a hover right after real movement counts as the visitor's.
     */
    let movedAt = -Infinity;
    const meantHover = (event: PointerEvent) => event.timeStamp - movedAt < 150;

    /**
     * The pointer entered a card: it strikes the card where it crossed the edge, the point of the
     * edge nearest the pointer. Entering the item through its caption, away from the card, is none.
     */
    const enter = (item: Placed, event: PointerEvent) => {
      const light = item.light;
      if (!light || light.scale <= 0) return;
      const [ox, oy] = scene.origin;
      const x = (event.clientX - ox - light.x) / light.scale;
      const y = (event.clientY - oy - light.y) / light.scale;
      const { w, h } = item.solid;
      const slack = 8;
      if (x < -slack || y < -slack || x > w + slack || y > h + slack) return;
      const edges = [
        { d: Math.abs(x), point: [0, y], normal: [-1, 0] },
        { d: Math.abs(w - x), point: [w, y], normal: [1, 0] },
        { d: Math.abs(y), point: [x, 0], normal: [0, -1] },
        { d: Math.abs(h - y), point: [x, h], normal: [0, 1] },
      ] as const;
      const nearest = edges.reduce((best, edge) => (edge.d < best.d ? edge : best));
      const clamp = (value: number, max: number) => Math.min(max, Math.max(0, value));
      strike(item, [clamp(nearest.point[0], w), clamp(nearest.point[1], h)], nearest.normal);
    };
    const sameItem = (event: PointerEvent | FocusEvent, item: Placed) =>
      event.relatedTarget instanceof Element && item.element.contains(event.relatedTarget);
    canvas.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'touch') return;
      const item = itemOf(event.target);
      if (!item || item.hovered) return;
      // While a pilot flies, cards pass under a resting pointer; they rise only for a moving one.
      if (scene.pilot?.active && !meantHover(event)) return;
      takeOver('hover');
      item.hovered = true;
      enter(item, event);
      run();
    });
    canvas.addEventListener('pointerout', (event) => {
      const item = itemOf(event.target);
      if (!item || sameItem(event, item)) return;
      item.hovered = false;
      run();
    });
    canvas.addEventListener('focusout', (event) => {
      const item = itemOf(event.target);
      if (!item || sameItem(event, item)) return;
      item.focused = false;
      run();
    });
    const stopDrift = () => {
      clearTimeout(resumeTimer);
      drifting = false;
    };

    // Drag to pan, from anywhere that is not a control.
    // Library elements that are surfaces rather than controls; dragging over them pans.
    const surfaces = new Set([
      'TP-CARD',
      'TP-MO-GLOW-BORDER',
      'TP-LIST-ITEM-GROUP',
      'TP-LIST-ITEM',
      'TP-PROGRESS',
      'TP-BADGE',
      'TP-AVATAR',
      'TP-ALERT',
    ]);
    const isControl = (target: Element) => {
      if (target.closest('a, button, input, textarea, select, label, [contenteditable]')) return true;
      for (let node: Element | null = target; node && node !== canvas; node = node.parentElement) {
        if (node.tagName.startsWith('TP-') && !surfaces.has(node.tagName)) return true;
      }
      return false;
    };
    let drag: { id: number; x: number; y: number; time: number } | null = null;
    const touches = new Map<number, { x: number; y: number }>();
    let touchDrag: { x: number; y: number } | null = null;
    let suppressTouchClickUntil = 0;
    const touchCentre = () => {
      const [a, b] = [...touches.values()];
      return a && b ? { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 } : null;
    };
    canvas.addEventListener('click', (event) => {
      if (performance.now() >= suppressTouchClickUntil) return;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, true);

    canvas.addEventListener('pointerdown', (event) => {
      takeOver('drag');
      stopDrift();
      if (event.button !== 0) return;
      // Text and card surfaces inside a composition still drag; controls keep the pointer.
      if (isControl(event.target as Element)) return;
      if (event.pointerType === 'touch') {
        touches.set(event.pointerId, { x: event.clientX, y: event.clientY });
        canvas.setPointerCapture(event.pointerId);
        touchDrag = touchCentre();
        velocity.x = velocity.y = 0;
        if (touchDrag) {
          canvas.dataset.dragging = '';
          suppressTouchClickUntil = performance.now() + 400;
          event.preventDefault();
        }
        return;
      }
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, time: event.timeStamp };
      velocity.x = velocity.y = 0;
      canvas.setPointerCapture(event.pointerId);
      canvas.dataset.dragging = '';
      event.preventDefault();
    });
    // Over the open canvas, the mouse's own movement steers the drift, which keeps going the way
    // the mouse last went; over a composition the canvas holds still, so its controls stay put.
    let lastMouse: { x: number; y: number } | null = null;
    canvas.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') {
        if (!touches.has(event.pointerId)) return;
        touches.set(event.pointerId, { x: event.clientX, y: event.clientY });
        const centre = touchCentre();
        if (centre && touchDrag) {
          if (home?.dataset.experience === 'intro') return;
          if (home) home.dataset.experience = 'manual';
          world.inert = false;
          activity();
          takeOver('wheel');
          event.preventDefault();
          pan.x += centre.x - touchDrag.x;
          pan.y += centre.y - touchDrag.y;
          velocity.x = velocity.y = 0;
          suppressTouchClickUntil = performance.now() + 400;
          run();
        }
        touchDrag = centre;
        return;
      }
      if (!drag && event.pointerType === 'mouse') {
        if (!lastMouse || Math.hypot(event.clientX - lastMouse.x, event.clientY - lastMouse.y) >= 2) {
          movedAt = event.timeStamp;
        }
        if (itemOf(event.target)) {
          takeOver('hover');
          stopDrift();
        } else if (lastMouse) {
          const dx = event.clientX - lastMouse.x;
          const dy = event.clientY - lastMouse.y;
          if (Math.hypot(dx, dy) >= 1) {
            steer(dx, dy, 0.2);
            resume();
          }
        }
        lastMouse = { x: event.clientX, y: event.clientY };
        return;
      }
      if (!drag || event.pointerId !== drag.id) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      const dt = Math.max(1, event.timeStamp - drag.time);
      pan.x += dx;
      pan.y += dy;
      velocity.x = (dx / dt) * 16;
      velocity.y = (dy / dt) * 16;
      steer(dx, dy);
      drag = { id: drag.id, x: event.clientX, y: event.clientY, time: event.timeStamp };
      run();
    });
    const release = (event: PointerEvent) => {
      if (event.pointerType === 'touch') {
        if (!touches.delete(event.pointerId)) return;
        if (touchDrag) suppressTouchClickUntil = performance.now() + 400;
        touchDrag = touchCentre();
        velocity.x = velocity.y = 0;
        if (!touchDrag) delete canvas.dataset.dragging;
        return;
      }
      if (!drag || event.pointerId !== drag.id) return;
      drag = null;
      delete canvas.dataset.dragging;
      if (reduceMotion) velocity.x = velocity.y = 0;
      // Let go slowly, or held still, the canvas drifts on the way it was last dragged.
      if (Math.hypot(velocity.x, velocity.y) <= DRIFT_SPEED) resume();
      run();
    };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('lostpointercapture', release);

    // Wheel and trackpad pan in both directions.
    canvas.addEventListener(
      'wheel',
      (event) => {
        takeOver('wheel');
        stopDrift();
        event.preventDefault();
        const scale = event.deltaMode === 1 ? 16 : 1;
        const dx = -(event.shiftKey ? event.deltaY : event.deltaX) * scale;
        const dy = -(event.shiftKey ? 0 : event.deltaY) * scale;
        pan.x += dx;
        pan.y += dy;
        steer(dx, dy);
        resumeLater();
        velocity.x = velocity.y = 0;
        run();
      },
      { passive: false },
    );

    // Arrow keys pan while the canvas itself has focus.
    canvas.addEventListener('keydown', (event) => {
      if (event.target !== canvas) return;
      const step = event.shiftKey ? 240 : 80;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [step, 0],
        ArrowRight: [-step, 0],
        ArrowUp: [0, step],
        ArrowDown: [0, -step],
      };
      const move = moves[event.key];
      if (!move) return;
      event.preventDefault();
      takeOver('key');
      stopDrift();
      pan.x += move[0];
      pan.y += move[1];
      steer(move[0], move[1]);
      resumeLater();
      run();
    });

    // Tabbing into a composition that is partly off screen brings it into view.
    canvas.addEventListener('focusin', (event) => {
      takeOver('focus');
      stopDrift();
      const item = (event.target as Element).closest<HTMLElement>('[data-item]');
      if (!item) return;
      const placed = placedOf.get(item);
      if (placed && !placed.focused) {
        placed.focused = true;
        run();
      }
      const box = item.getBoundingClientRect();
      // The canvas's own frame was read when it was built; the scene keeps it.
      const frameBox = {
        left: scene.origin[0],
        top: scene.origin[1],
        right: scene.origin[0] + scene.size[0],
        bottom: scene.origin[1] + scene.size[1],
      };
      const left = frameBox.left + inset.left;
      const top = frameBox.top + inset.top;
      const pad = 32;
      if (box.left < left + pad) pan.x += left + pad - box.left;
      else if (box.right > frameBox.right - pad)
        pan.x -= Math.min(box.right - frameBox.right + pad, box.left - left - pad);
      if (box.top < top + pad) pan.y += top + pad - box.top;
      else if (box.bottom > frameBox.bottom - pad)
        pan.y -= Math.min(box.bottom - frameBox.bottom + pad, box.top - top - pad);
      run();
    });
    canvas.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      lastMouse = null;
      if (!drag) resume();
    });

    // The page changed what its chrome covers (its scroll padding): read it again.
    canvas.addEventListener('coveredchange', () => {
      inset = covered();
      scene.publish({ inset: [inset.left, inset.top] });
    });

    // Demo forms show their states but never leave the page.
    canvas.addEventListener('submit', (event) => event.preventDefault());
    canvas.addEventListener('input', (event) => {
      const item = itemOf(event.target);
      if (item) item.element.dataset.userEdited = '';
    });

    let resizeTimer = 0;
    const onResize = () => {
      if (!canvas.isConnected) {
        removeEventListener('resize', onResize);
        return;
      }
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        build();
        render();
        run();
      }, 150);
    };
    addEventListener('resize', onResize);

    /** Applies the glow's parameters to the light and to every card's Glow border. */
    const applyGlow = () => {
      cardGlow.setParams({ reach: params.glowReach, impact: params.glowImpact });
      for (const element of world.querySelectorAll<TpMoGlowBorder>('tp-mo-glow-border')) {
        element.trackReach = params.glowReach;
      }
    };

    /** In development, the gaps, the dot grid and the glow join the tuning panel (lib/tuning.ts). */
    const tune = async () => {
      const { addSection, storedParams } = await import('../lib/tuning');
      if (!canvas.isConnected) return;
      const stored = storedParams(TUNING_KEY, DEFAULT_CANVAS_PARAMS);
      const regap = stored.gapX !== params.gapX || stored.gapY !== params.gapY;
      assignParams(params, stored);
      applyGlow();
      // Stored gaps are a new packing, but never under a playing intro.
      if (regap && !home?.hasAttribute('data-intro')) {
        build();
        render();
      }
      const remove = addSection({
        key: TUNING_KEY,
        title: 'Canvas',
        params,
        defaults: DEFAULT_CANVAS_PARAMS,
        literal: { name: 'DEFAULT_CANVAS_PARAMS', type: 'CanvasParams' },
        // Only new gaps pack the world again; the dot grid's speed needs just a redraw.
        apply: () => {
          applyGlow();
          const [gapX, gapY] = scene.layout?.gap ?? [];
          if (gapX !== params.gapX || gapY !== params.gapY) build();
          render();
        },
        build(folder) {
          folder.addBinding(params, 'gapX', { label: 'gap x', min: 16, max: 240, step: 1 });
          folder.addBinding(params, 'gapY', { label: 'gap y', min: 16, max: 240, step: 1 });
          folder.addBinding(params, 'parallax', { label: 'dot parallax', min: 0, max: 1, step: 0.01 });
          folder.addBinding(params, 'glowReach', { label: 'glow reach', min: 40, max: 600, step: 1 });
          folder.addBinding(params, 'glowImpact', { label: 'glow impact', min: 0.1, max: 3, step: 0.05 });
        },
      });
      document.addEventListener('astro:before-swap', remove, { once: true });
    };

    /** Prepares, while the intro plays, the elements its descent will show. */
    const prepareOpening = () => {
      const opening = layout?.opening;
      if (!opening || !mosaic) return;
      const [width, height] = scene.size;
      const landing = mosaic.items[opening.landing]!;
      // The views from the start down to the landing card, with the mounting guard.
      const guard = Math.max(layout!.cardWidth, 240);
      const views: Box[] = [];
      for (let top = -pan.y; top < landing.y + landing.h; top += height / 3) {
        views.push({ x: -pan.x - guard, y: top - guard, w: width + guard * 2, h: height + guard * 2 });
      }
      prepare(views);
    };

    const start = async () => {
      await Promise.all(['tp-card', 'tp-button', 'tp-field', 'tp-input'].map((tag) => customElements.whenDefined(tag)));
      // Only the server-rendered originals are measured; one render of each is all that is waited for.
      await Promise.all(originals.flatMap((element) => [...element.querySelectorAll('*')]).map((element) => (element as HTMLElement & { updateComplete?: Promise<unknown> }).updateComplete));
      await document.fonts.ready;
      if (disposed || !canvas.isConnected) return;
      canvas.dataset.ready = '';
      build();
      centre();
      render();
      run();
      canvas.dataset.layoutSettled = '';
      prepareOpening();
      // Production builds leave the tuning panel out altogether, not just closed.
      if (import.meta.env.DEV) await tune();
    };

    // Motion can be reduced, or allowed again, while the page is open.
    const motionChanged = () => {
      if (!canvas.isConnected) {
        motionQuery.removeEventListener('change', motionChanged);
        return;
      }
      reduceMotion = motionQuery.matches;
      if (reduceMotion) drifting = false;
      else resume();
    };
    motionQuery.addEventListener('change', motionChanged);

    // A pilot that arrives once the canvas has gone still needs its frames.
    const unsubscribeScene = scene.subscribe(() => {
      if (scene.pilot && !frame && canvas.isConnected && canvas.dataset.ready !== undefined) run();
    });

    // ---- The home page's experience: the intro, then the autopilot, then the visitor. ----
    let idleTimer: ReturnType<typeof setTimeout> | undefined;
    const manual = () => home?.dataset.experience === 'manual';
    const activity = () => {
      if (!manual()) return;
      scene.pilot?.interrupt('wheel');
      clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        if (!home?.isConnected) return;
        home.dataset.experience = 'auto';
        world.inert = true;
        home.dispatchEvent(new Event('autoresume'));
        for (const item of mounted.values()) item.hovered = item.focused = false;
        run();
      }, 5000);
    };
    const gate = (event: Event) => {
      if (!home) return;
      const key = event as KeyboardEvent;
      const scroll = event.type === 'wheel' || (event.type === 'keydown' && event.target === canvas && key.key.startsWith('Arrow'));
      if (home.dataset.experience !== 'intro' && scroll) {
        home.dataset.experience = 'manual';
        world.inert = false;
      }
      if (!manual()) {
        // Touch pointers must be tracked to recognize the existing two-finger pan.
        if ((event as PointerEvent).pointerType === 'touch' && home.dataset.experience === 'auto') return;
        event.stopImmediatePropagation();
        if (event.cancelable) event.preventDefault();
        return;
      }
      // Moving cards can generate pointer events under a resting mouse.
      const restingMouse = event instanceof PointerEvent && event.type === 'pointermove' && event.pointerType === 'mouse' && event.movementX === 0 && event.movementY === 0;
      if (!restingMouse && !['pointerover', 'focusin'].includes(event.type)) activity();
    };
    if (home) {
      for (const type of ['wheel', 'pointerdown', 'pointermove', 'pointerover', 'keydown', 'input', 'click', 'focusin']) canvas.addEventListener(type, gate, { capture: true, passive: false });
      world.inert = !manual();
      home.addEventListener('introstart', () => { world.inert = true; clearTimeout(idleTimer); });
      // The sticky header has opened, the opening card out of view: its slot's own card takes over.
      home.addEventListener('introsticky', () => {
        heroInSlot = false;
        if (mosaic?.hero !== undefined) {
          const placed = mounted.get(`${mosaic.hero}:0`);
          if (placed) unmount(`${mosaic.hero}:0`, placed);
        }
        render();
      });
      home.addEventListener('introcomplete', () => {
        stopDrift();
        velocity.x = velocity.y = 0;
        panVelocity = [0, 0];
        run();
      });
      // The intro starts over: the intro card is back in its slot, packed afresh.
      canvas.addEventListener('introgridreset', (event) => {
        openingDistance = (event as CustomEvent<{ distanceCards: number }>).detail.distanceCards;
        heroInSlot = true;
        if (canvas.dataset.ready === undefined) return;
        build();
        centre();
        render();
        prepareOpening();
      });
      canvas.addEventListener('introreset', () => {
        centre();
        render();
      });
    }
    document.addEventListener('astro:before-swap', () => {
      disposed = true;
      frame?.();
      if (idle) cancelIdleCallback(idle);
      clearTimeout(resumeTimer);
      clearTimeout(resizeTimer);
      clearTimeout(idleTimer);
      unsubscribeScene();
      removeEventListener('resize', onResize);
      motionQuery.removeEventListener('change', motionChanged);
      document.removeEventListener('visibilitychange', visibilityChanged);
      canvas.removeEventListener('pointermove', trackLight);
      canvas.removeEventListener('pointerleave', leaveLight);
    }, { once: true });
    start();
  }

  // The home page arrives through the client router as well as on first load; this module runs
  // once, so the canvas is set up from the page-load event.
  document.addEventListener('astro:page-load', setup);
  setup();
</script>
