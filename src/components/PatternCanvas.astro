        title: 'Canvas',
        params,
        defaults: DEFAULT_CANVAS_PARAMS,
        literal: { name: 'DEFAULT_CANVAS_PARAMS', type: 'CanvasParams' },
        // Only new gaps lay the columns out again; the dot grid's speed needs just a redraw.
