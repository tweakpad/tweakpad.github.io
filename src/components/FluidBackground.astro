---
/**
 * The interactive fluid from vgpu's example gallery (https://vgpu.sh/examples/fluid), as water
 * the pattern canvas that follows it floats on, in two layers. Behind the cards, the water is dark
 * until a card pushes it: the rectangles the parent's scene publishes (lib/scene.ts) are hulls it
 * flows around, and where a moving or rising card squeezes it, its pressure lights the water
 * around the card (the card's border is its own Glow border, lit by lib/card-glow.ts). Pointer
 * movement anywhere over the parent element stirs it with coloured dye. Under the water, the
 * canvas's dot grid is drawn as a floor that catches light: a light over it follows the pointer,
 * or the autopilot's trail head, and the water's own light reflects in the dots; once it draws,
 * the canvas leaves its CSS dots out (`data-dot-surface` on the stage). Over the
 * cards, a fog in the page's own colour veils those at rest and opens over one lifted on hover.
 * It needs WebGPU; where that is missing, or the device fails, the canvases stay empty and
 * transparent. With reduced motion it draws one settled frame, still water, and stops. In
 * development, a Tweakpane panel tunes it live (lib/fluid/tuning.ts); production builds leave the
 * panel out.
 */
---

<canvas class="fluid" data-fluid="dots" aria-hidden="true"></canvas>
<canvas class="fluid" data-fluid="lights" aria-hidden="true"></canvas>
<canvas class="fluid fluid--fog" data-fluid="fog" aria-hidden="true"></canvas>

<style>
  /* The water comes before the pattern canvas, so it paints under it. */
  .fluid {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }

  /* Over the canvas; a lifted card, at the same level but later, rises above it. */
  .fluid--fog {
    z-index: 1;
  }
</style>

<script>
  import type { FluidColors } from '../lib/fluid/simulation';

  type Rgb = readonly [number, number, number];

  /** Reads a colour the page resolves for `value`, as sRGB 0..1. */
  function resolveColor(host: HTMLElement, value: string, fallback: Rgb): Rgb {
    const probe = document.createElement('span');
    probe.style.cssText = `position:absolute;visibility:hidden;color:${value}`;
    host.append(probe);
    const resolved = getComputedStyle(probe).color;
    probe.remove();
    const numbers = resolved.match(/-?\d*\.?\d+/g)?.map(Number) ?? [];
    if (resolved.startsWith('rgb') && numbers.length >= 3) {
      return [numbers[0]! / 255, numbers[1]! / 255, numbers[2]! / 255];
    }
    if (resolved.startsWith('color(srgb') && numbers.length >= 3) {
      return [numbers[0]!, numbers[1]!, numbers[2]!];
    }
    return fallback;
  }

  function pageColors(host: HTMLElement): FluidColors {
    const fog = resolveColor(host, 'var(--tp-background)', [0.09, 0.09, 0.11]);
    const pressure = resolveColor(host, 'var(--tp-primary)', [0.55, 0.49, 1]);
    const dots = resolveColor(host, 'var(--tp-foreground)', [0.98, 0.98, 0.98]);
    // A white light cannot brighten a light page, so there the light over the dots takes the
    // primary colour; on a dark page it is the foreground's.
    const light = 0.2126 * fog[0] + 0.7152 * fog[1] + 0.0722 * fog[2] > 0.5;
    return { fog, pressure, dots, light: light ? pressure : dots };
  }

  async function setup() {
    const lights = document.querySelector<HTMLCanvasElement>('[data-fluid="lights"]:not([data-setup])');
    const fog = lights?.parentElement?.querySelector<HTMLCanvasElement>('[data-fluid="fog"]');
    const dots = lights?.parentElement?.querySelector<HTMLCanvasElement>('[data-fluid="dots"]') ?? undefined;
    if (!lights || !fog) return;
    if (!('gpu' in navigator)) { lights.parentElement!.dataset.fluidReady = ''; return; }
    lights.dataset.setup = '';
    // The solver and vgpu load only where WebGPU exists, and the tuning panel only in development:
    // production builds leave it out.
    const [{ createRenderer }, { sceneOf }, tuning] = await Promise.all([
      import('../lib/fluid/renderer'),
      import('../lib/scene'),
      import.meta.env.DEV ? import('../lib/fluid/tuning') : undefined,
    ]);
    if (!lights.isConnected || !fog.isConnected) return;
    const stage = lights.parentElement ?? lights;
    const params = tuning?.fluidParams();
    const home = stage.closest('.home');
    const renderer = createRenderer({
      lights,
      fog,
      dots,
      input: stage,
      paused: home?.hasAttribute('data-intro') ?? false,
      scene: sceneOf(stage),
      colors: pageColors(stage),
      params,
      still: matchMedia('(prefers-reduced-motion: reduce)').matches,
    });
    let activationFrame = 0;
    const pause = () => {
      cancelAnimationFrame(activationFrame);
      renderer.setPaused(true);
      delete stage.dataset.fluidActive;
    };
    const activate = () => {
      cancelAnimationFrame(activationFrame);
      // Let the timeline's final glyph and opacity writes paint before stepping water.
      activationFrame = requestAnimationFrame(() => {
        if (!stage.isConnected || home?.hasAttribute('data-intro')) return;
        renderer.setPaused(false);
        stage.dataset.fluidActive = '';
      });
    };
    home?.addEventListener('introstart', pause);
    home?.addEventListener('introcomplete', activate);
    if (!home?.hasAttribute('data-intro')) activate();
    const closeTuning = params && tuning?.tuneFluid(params, renderer.setParams);
    // The theme switch sets color-scheme on <html>; the system scheme may change underneath too.
    const recolor = () => renderer.setColors(pageColors(stage));
    const observer = new MutationObserver(recolor);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['style', 'class'] });
    const scheme = matchMedia('(prefers-color-scheme: dark)');
    scheme.addEventListener('change', recolor);
    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        cancelAnimationFrame(activationFrame);
        home?.removeEventListener('introstart', pause);
        home?.removeEventListener('introcomplete', activate);
        scheme.removeEventListener('change', recolor);
        closeTuning?.();
        renderer.dispose();
      },
      { once: true },
    );
    renderer.ready.finally(() => { stage.dataset.fluidReady = ''; }).then(
      () => {
        // The grid is drawn as a surface from here on; without WebGPU, the CSS dots stay.
        if (dots && lights.isConnected) stage.dataset.dotSurface = '';
      },
      (error: unknown) => console.warn('Fluid background unavailable.', error),
    );
  }

  // Like the pattern canvas, the home page also arrives through the client router.
  document.addEventListener('astro:page-load', setup);
  setup();
</script>
