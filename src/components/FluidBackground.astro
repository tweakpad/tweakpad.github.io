---
/**
 * The interactive fluid from vgpu's example gallery (https://vgpu.sh/examples/fluid), as water
 * the pattern canvas that follows it floats on, in two layers. Behind the cards, the water is dark
 * until a card pushes it: the rectangles the parent's scene publishes (lib/scene.ts) are hulls it
 * flows around, and where a moving or rising card squeezes it, its pressure lights the card's
 * border. Pointer movement anywhere over the parent element stirs it with coloured dye. Over the
 * cards, a fog in the page's own colour veils those at rest and opens over one lifted on hover.
 * It needs WebGPU; where that is missing, or the device fails, the canvases stay empty and
 * transparent. With reduced motion it draws one settled frame, still water, and stops. In
 * development, or with ?tune in the address, a Tweakpane panel tunes it live
 * (lib/fluid/tuning.ts).
 */
---

<canvas class="fluid" data-fluid="lights" aria-hidden="true"></canvas>
<canvas class="fluid fluid--fog" data-fluid="fog" aria-hidden="true"></canvas>

<style>
  /* The water comes before the pattern canvas, so it paints under it. */
  .fluid {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }

  /* Over the canvas; a lifted card, at the same level but later, rises above it. */
  .fluid--fog {
    z-index: 1;
  }
</style>

<script>
  import type { FluidColors } from '../lib/fluid/simulation';

  type Rgb = readonly [number, number, number];

  /** Reads a colour the page resolves for `value`, as sRGB 0..1. */
  function resolveColor(host: HTMLElement, value: string, fallback: Rgb): Rgb {
    const probe = document.createElement('span');
    probe.style.cssText = `position:absolute;visibility:hidden;color:${value}`;
    host.append(probe);
    const resolved = getComputedStyle(probe).color;
    probe.remove();
    const numbers = resolved.match(/-?\d*\.?\d+/g)?.map(Number) ?? [];
    if (resolved.startsWith('rgb') && numbers.length >= 3) {
      return [numbers[0]! / 255, numbers[1]! / 255, numbers[2]! / 255];
    }
    if (resolved.startsWith('color(srgb') && numbers.length >= 3) {
      return [numbers[0]!, numbers[1]!, numbers[2]!];
    }
    return fallback;
  }

  function pageColors(host: HTMLElement): FluidColors {
    return {
      fog: resolveColor(host, 'var(--tp-background)', [0.09, 0.09, 0.11]),
      pressure: resolveColor(host, 'var(--tp-primary)', [0.55, 0.49, 1]),
    };
  }

  async function setup() {
    const lights = document.querySelector<HTMLCanvasElement>('[data-fluid="lights"]:not([data-setup])');
    const fog = lights?.parentElement?.querySelector<HTMLCanvasElement>('[data-fluid="fog"]');
    if (!lights || !fog || !('gpu' in navigator)) return;
    lights.dataset.setup = '';
    // The solver and vgpu load only where WebGPU exists, and the tuning panel only when asked for.
    const tune = import.meta.env.DEV || new URLSearchParams(location.search).has('tune');
    const [{ createRenderer }, { sceneOf }, tuning] = await Promise.all([
      import('../lib/fluid/renderer'),
      import('../lib/scene'),
      tune ? import('../lib/fluid/tuning') : undefined,
    ]);
    const stage = lights.parentElement ?? lights;
    const params = tuning?.storedParams();
    const renderer = createRenderer({
      lights,
      fog,
      input: stage,
      scene: sceneOf(stage),
      colors: pageColors(stage),
      params,
      still: matchMedia('(prefers-reduced-motion: reduce)').matches,
    });
    const closeTuning = params && tuning?.mountTuning(params, renderer.setParams);
    // The theme switch sets color-scheme on <html>; the system scheme may change underneath too.
    const recolor = () => renderer.setColors(pageColors(stage));
    const observer = new MutationObserver(recolor);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['style', 'class'] });
    const scheme = matchMedia('(prefers-color-scheme: dark)');
    scheme.addEventListener('change', recolor);
    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        scheme.removeEventListener('change', recolor);
        closeTuning?.();
        renderer.dispose();
      },
      { once: true },
    );
    renderer.ready.catch((error: unknown) => console.warn('Fluid background unavailable.', error));
  }

  // Like the pattern canvas, the home page also arrives through the client router.
  document.addEventListener('astro:page-load', setup);
  setup();
</script>
