---
/**
 * The interactive fluid from vgpu's example gallery (https://vgpu.sh/examples/fluid), drawn behind
 * the pattern canvas. Pointer movement anywhere over the parent element stirs it, and elements
 * marked `data-fluid-solid` inside the parent are walls it flows around. It needs
 * WebGPU; where that is missing, or the device fails, the canvas stays empty and transparent.
 * With reduced motion it draws one settled frame and stops.
 */
---

<canvas class="fluid" data-fluid aria-hidden="true"></canvas>

<style>
  .fluid {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }
</style>

<script>
  async function setup() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-fluid]:not([data-setup])');
    if (!canvas || !('gpu' in navigator)) return;
    canvas.dataset.setup = '';
    // The solver and vgpu load only where WebGPU exists.
    const { createRenderer } = await import('../lib/fluid/renderer');
    const stage = canvas.parentElement ?? canvas;
    const renderer = createRenderer({
      canvas,
      input: stage,
      solids: () => stage.querySelectorAll('[data-fluid-solid]'),
      still: matchMedia('(prefers-reduced-motion: reduce)').matches,
    });
    document.addEventListener('astro:before-swap', () => renderer.dispose(), { once: true });
    renderer.ready.catch((error: unknown) => console.warn('Fluid background unavailable.', error));
  }

  // Like the pattern canvas, the home page also arrives through the client router.
  document.addEventListener('astro:page-load', setup);
  setup();
</script>
