---
import { docPath, docsByGroup, sortedPatterns } from '../lib/content';
import { url } from '../lib/url';

// The search index is the site's own page list, built once per page render.
const docGroups = await docsByGroup();
const index = [
  ...docGroups.map((group) => ({
    type: 'group',
    label: group.label,
    items: group.entries.map((entry) => ({
      value: url(docPath(entry)),
      label: entry.data.title,
      keywords: ['tag' in entry.data ? entry.data.tag : '', group.label],
    })),
  })),
  {
    type: 'group',
    label: 'Patterns',
    items: (await sortedPatterns()).map((entry) => ({
      value: url(`/patterns/${entry.id}`),
      label: entry.data.title,
      keywords: [entry.data.category, ...entry.data.components],
    })),
  },
  {
    type: 'group',
    label: 'Kits',
    items: [{ value: url('/kits'), label: 'Kits (coming soon)', keywords: ['kit'] }],
  },
];
---

<button class="search-trigger" type="button" data-search-trigger aria-label="Search documentation">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
  </svg>
  <span>Search docs…</span>
  <kbd data-search-shortcut>⌘K</kbd>
</button>
<tp-command-palette
  data-search
  data-index={JSON.stringify(index)}
  label="Search"
  description="Search components, patterns and kits."
  placeholder="Search components, patterns and kits…"
  loop-navigation></tp-command-palette>

<script>
  import type { TpCommandPalette } from '@tweakpad/ui';
  import { navigate } from 'astro:transitions/client';

  const palette = document.querySelector<TpCommandPalette>('[data-search]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-search-trigger]');

  if (palette && trigger) {
    // Module scripts run in document order; the elements may not be defined yet.
    await customElements.whenDefined('tp-command-palette');
    palette.items = JSON.parse(palette.dataset.index ?? '[]');
    palette.registerTrigger(trigger);
    palette.addEventListener('tp-execute', (event) => {
      const target = (event as CustomEvent<{ commandId: unknown }>).detail.commandId;
      if (typeof target === 'string') navigate(target);
    });

    if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
      const shortcut = trigger.querySelector('[data-search-shortcut]');
      if (shortcut) shortcut.textContent = 'Ctrl K';
    }

    document.addEventListener('keydown', (event) => {
      // The innermost target: inside a shadow root, `event.target` is the host (a tp-input or
      // tp-text-editor), not the field or editing root that has the key.
      const origin = event.composedPath()[0];
      const editing =
        origin instanceof HTMLElement &&
        (origin.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(origin.tagName));
      const shortcut =
        (event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !editing);
      if (!shortcut) return;
      event.preventDefault();
      palette.setOpen(true, 'imperative-action', event);
    });
  }
</script>
