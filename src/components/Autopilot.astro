---
/**
 * The autopilot (lib/autopilot): a camera that flies the pattern canvas before it from card to
 * card, sending a trail head through the hallways between them that stirs the water. It joins
 * its stage's scene as the canvas's pilot; the visitor's input takes the canvas back, and the
 * autopilot resumes once they have left it alone a while. Off with reduced motion. It draws
 * nothing of its own; the template only marks its stage. In development, the tuning panel tunes
 * it, and its debug overlay draws on the stage; production builds leave both out.
 */
---

<template data-autopilot></template>

<script>
  import { DEFAULT_AUTOPILOT_PARAMS } from '../lib/autopilot/params';
  import { cloneParams } from '../lib/params';

  async function setup() {
    const anchor = document.querySelector<HTMLElement>('[data-autopilot]:not([data-setup])');
    const stage = anchor?.parentElement;
    if (!anchor || !stage) return;
    anchor.dataset.setup = '';
    const [{ createAutopilot }, { sceneOf }, tools] = await Promise.all([
      import('../lib/autopilot/director'),
      import('../lib/scene'),
      // Development only: production builds leave the tuning panel and the overlay out altogether.
      import.meta.env.DEV
        ? Promise.all([import('../lib/autopilot/tuning'), import('../lib/autopilot/overlay')])
        : undefined,
    ]);
    if (!anchor.isConnected) return;
    const tuning = tools?.[0];
    const overlay = tools?.[1];
    const scene = sceneOf(stage);
    const params = tuning?.autopilotParams() ?? cloneParams(DEFAULT_AUTOPILOT_PARAMS);
    const autopilot = createAutopilot(scene, params);
    const closeTuning = tuning?.tuneAutopilot(params, autopilot.setParams);
    const removeOverlay = overlay?.mountOverlay(anchor, scene, autopilot);

    // With reduced motion the canvas keeps still, and nothing flies it.
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const attach = () => scene.publish(motion.matches ? { pilot: null, stir: null } : { pilot: autopilot.pilot });
    attach();
    motion.addEventListener('change', attach);

    document.addEventListener(
      'astro:before-swap',
      () => {
        motion.removeEventListener('change', attach);
        closeTuning?.();
        removeOverlay?.();
        autopilot.dispose();
      },
      { once: true },
    );
  }

  // Like the pattern canvas, the home page also arrives through the client router.
  document.addEventListener('astro:page-load', setup);
  setup();
</script>
