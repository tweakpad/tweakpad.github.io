---
import { elementApi, prose } from '../lib/manifest';
import Signature from './Signature.astro';

interface Props {
  tag: string;
  /** Heading level of each group: `h3` for the page's element, `h4` under a part's own heading. */
  level?: 'h3' | 'h4';
  /**
   * `properties`: the Properties table under the hero, every property once. `reference`: the API
   * Reference, only what that table does not cover. `all`: both, for a part's own section.
   */
  mode?: 'properties' | 'reference' | 'all';
  /** Leave the Properties group's own heading out (the page heads it). */
  bare?: boolean;
}
const { tag, level = 'h3', mode = 'all', bare = false } = Astro.props;
const api = elementApi(tag);
const Heading = level;


interface Column {
  title: string;
  /**
   * Cell text; `code` cells are shown as code, `prose` cells keep their backtick spans and
   * `signature` cells are TypeScript whose type names open their cards.
   */
  value: (row: any) => string;
  as?: 'code' | 'prose' | 'text' | 'signature';
}
interface Group {
  name: string;
  rows: any[];
  columns: Column[];
}
/**
 * The Properties table (one row per property, the attribute that sets it under its name), then the
 * API Reference groups: Events, Methods, Slots, CSS parts and CSS custom properties.
 */
const propertiesGroup: Group[] = api
  ? [
      {
        name: 'Properties',
        rows: api.members,
        columns: [
          { title: 'Property', value: (row) => row.name, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
          { title: 'Type', value: (row) => row.type, as: 'signature' },
          { title: 'Default', value: (row) => row.default, as: 'code' },
        ],
      },
    ]
  : [];
const referenceGroups: Group[] = api
  ? [
      {
        name: 'Events',
        rows: api.events,
        columns: [
          { title: 'Event', value: (row) => row.name, as: 'code' },
          { title: 'Type', value: (row) => row.type, as: 'signature' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'Methods',
        rows: api.methods,
        columns: [
          { title: 'Method', value: (row) => row.signature, as: 'signature' },
          { title: 'Returns', value: (row) => row.returns, as: 'signature' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'Slots',
        rows: api.slots,
        columns: [
          { title: 'Slot', value: (row) => row.name || 'default', as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'CSS parts',
        rows: api.cssParts,
        columns: [
          { title: 'Part', value: (row) => `::part(${row.name})`, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'CSS custom properties',
        rows: api.cssProperties,
        columns: [
          { title: 'Property', value: (row) => row.name, as: 'code' },
          { title: 'Default', value: (row) => row.default, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
    ]
  : [];
const groups = [
  ...(mode === 'reference' ? [] : propertiesGroup),
  ...(mode === 'properties' ? [] : referenceGroups),
].filter((group) => group.rows.length > 0);
const groupId = (name: string) => `api-${tag}-${name.toLowerCase().replace(/\s+/g, '-')}`;
---

{
  api ? (
    <div class="api-reference">
      {groups.map((group) => (
        <>
          {!(bare && group.name === 'Properties') && <Heading id={groupId(group.name)}>{group.name}</Heading>}
          {/* Library Tables: each owns its overflow and is a named region; the name column heads each row. */}
          <tp-table class="api" label={`${tag} ${group.name.toLowerCase()}`}>
            <tp-table-header>
              <tp-table-row>
                {group.columns.map((column) => (
                  <tp-table-head>{column.title}</tp-table-head>
                ))}
              </tp-table-row>
            </tp-table-header>
            <tp-table-body>
              {group.rows.map((row) => (
                <tp-table-row>
                  {group.columns.map((column, index) => {
                    const value = column.value(row);
                    const content = !value ? (
                      '—'
                    ) : column.as === 'signature' ? (
                      <Signature tag={tag} code={value} />
                    ) : column.as === 'prose' ? (
                      prose(tag, value).map((part) =>
                        part.ref ? (
                          <code>
                            <button type="button" class="api-type-ref" data-tp-ref={part.ref}>
                              {part.text}
                            </button>
                          </code>
                        ) : part.code ? (
                          <code>{part.text}</code>
                        ) : (
                          part.text
                        ),
                      )
                    ) : (
                      <code>{value}</code>
                    );
                    return index === 0 ? (
                      <tp-table-head scope="row">
                        {content}
                        {group.name === 'Properties' && row.attribute && (
                          <span class="api-attribute">
                            attribute <code>{row.attribute}</code>
                          </span>
                        )}
                        {group.name === 'Properties' && row.readonly && <span class="api-flag">read-only</span>}
                      </tp-table-head>
                    ) : (
                      <tp-table-cell>{content}</tp-table-cell>
                    );
                  })}
                </tp-table-row>
              ))}
            </tp-table-body>
          </tp-table>
        </>
      ))}
    </div>
  ) : (
    <p>
      No manifest entry for <code>{tag}</code>.
    </p>
  )
}
