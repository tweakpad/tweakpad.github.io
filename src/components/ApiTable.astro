---
import { elementApi } from '../lib/manifest';

interface Props {
  tag: string;
  /** Heading level of each group: `h3` for the page's element, `h4` under a part's own heading. */
  level?: 'h3' | 'h4';
}
const { tag, level = 'h3' } = Astro.props;
const api = elementApi(tag);
const Heading = level;

/** Manifest descriptions mark code with backticks. */
const prose = (text: string) => text.split('`');

interface Column {
  title: string;
  /** Cell text; `code` cells are shown as code, `prose` cells keep their backtick spans. */
  value: (row: any) => string;
  as?: 'code' | 'prose' | 'text';
}
interface Group {
  name: string;
  rows: any[];
  columns: Column[];
}
/** Attributes, Properties and Events first, then Methods, Slots, CSS parts and CSS custom properties. */
const allGroups: Group[] = api
  ? [
      {
        name: 'Attributes',
        rows: api.attributes,
        columns: [
          { title: 'Attribute', value: (row) => row.name, as: 'code' },
          { title: 'Property', value: (row) => row.property, as: 'code' },
          { title: 'Type', value: (row) => row.type, as: 'code' },
          { title: 'Default', value: (row) => row.default, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'Properties',
        rows: api.properties,
        columns: [
          { title: 'Property', value: (row) => row.name, as: 'code' },
          { title: 'Type', value: (row) => row.type, as: 'code' },
          { title: 'Default', value: (row) => row.default, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'Events',
        rows: api.events,
        columns: [
          { title: 'Event', value: (row) => row.name, as: 'code' },
          { title: 'Type', value: (row) => row.type, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'Methods',
        rows: api.methods,
        columns: [
          { title: 'Method', value: (row) => row.signature, as: 'code' },
          { title: 'Returns', value: (row) => row.returns, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'Slots',
        rows: api.slots,
        columns: [
          { title: 'Slot', value: (row) => row.name || 'default', as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'CSS parts',
        rows: api.cssParts,
        columns: [
          { title: 'Part', value: (row) => `::part(${row.name})`, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
      {
        name: 'CSS custom properties',
        rows: api.cssProperties,
        columns: [
          { title: 'Property', value: (row) => row.name, as: 'code' },
          { title: 'Default', value: (row) => row.default, as: 'code' },
          { title: 'Description', value: (row) => row.description, as: 'prose' },
        ],
      },
    ]
  : [];
const groups = allGroups.filter((group) => group.rows.length > 0);
const groupId = (name: string) => `api-${tag}-${name.toLowerCase().replace(/\s+/g, '-')}`;
---

{
  api ? (
    <div class="api-reference">
      {groups.map((group) => (
        <>
          <Heading id={groupId(group.name)}>{group.name}</Heading>
          {/* Library Tables: each owns its overflow and is a named region; the name column heads each row. */}
          <tp-table class="api" label={`${tag} ${group.name.toLowerCase()}`}>
            <tp-table-header>
              <tp-table-row>
                {group.columns.map((column) => (
                  <tp-table-head>{column.title}</tp-table-head>
                ))}
              </tp-table-row>
            </tp-table-header>
            <tp-table-body>
              {group.rows.map((row) => (
                <tp-table-row>
                  {group.columns.map((column, index) => {
                    const value = column.value(row);
                    const content = !value ? (
                      '—'
                    ) : column.as === 'prose' ? (
                      prose(value).map((part, at) => (at % 2 ? <code>{part}</code> : part))
                    ) : (
                      <code>{value}</code>
                    );
                    return index === 0 ? (
                      <tp-table-head scope="row">
                        {content}
                        {group.name === 'Properties' && row.readonly && <span class="api-flag">read-only</span>}
                      </tp-table-head>
                    ) : (
                      <tp-table-cell>{content}</tp-table-cell>
                    );
                  })}
                </tp-table-row>
              ))}
            </tp-table-body>
          </tp-table>
        </>
      ))}
    </div>
  ) : (
    <p>
      No manifest entry for <code>{tag}</code>.
    </p>
  )
}
