---
import { elementApi, uiVersion } from '../lib/manifest';

interface Props {
  tag: string;
  /** Also lists the element's own properties without an attribute, and its methods. */
  members?: boolean;
}
const { tag, members = false } = Astro.props;
const api = elementApi(tag);
const properties = members ? (api?.properties ?? []) : [];
const methods = members ? (api?.methods ?? []) : [];

/** Manifest descriptions mark code with backticks. */
const prose = (text: string) => text.split('`');
---

{
  api ? (
    <div class="api-reference">
      {/* Library Tables: each owns its overflow and is a named region; the name column heads each row. */}
      <tp-table class="api" label={`${tag} attributes`}>
        <tp-table-header>
          <tp-table-row>
            <tp-table-head>Attribute</tp-table-head>
            <tp-table-head>Type</tp-table-head>
            <tp-table-head>Default</tp-table-head>
          </tp-table-row>
        </tp-table-header>
        <tp-table-body>
          {api.attributes.map((attribute) => (
            <tp-table-row>
              <tp-table-head scope="row">
                <code>{attribute.name}</code>
              </tp-table-head>
              <tp-table-cell>
                <code>{attribute.type}</code>
              </tp-table-cell>
              <tp-table-cell>{attribute.default ? <code>{attribute.default}</code> : '—'}</tp-table-cell>
            </tp-table-row>
          ))}
        </tp-table-body>
      </tp-table>
      {properties.length > 0 && (
        <tp-table class="api" label={`${tag} properties`}>
          <tp-table-header>
            <tp-table-row>
              <tp-table-head>Property</tp-table-head>
              <tp-table-head>Type</tp-table-head>
              <tp-table-head>Description</tp-table-head>
            </tp-table-row>
          </tp-table-header>
          <tp-table-body>
            {properties.map((property) => (
              <tp-table-row>
                <tp-table-head scope="row">
                  <code>{property.name}</code>
                  {property.readonly && <span class="api-flag">read-only</span>}
                </tp-table-head>
                <tp-table-cell>
                  <code>{property.type}</code>
                </tp-table-cell>
                <tp-table-cell>
                  {property.description
                    ? prose(property.description).map((part, index) => (index % 2 ? <code>{part}</code> : part))
                    : '—'}
                </tp-table-cell>
              </tp-table-row>
            ))}
          </tp-table-body>
        </tp-table>
      )}
      {methods.length > 0 && (
        <tp-table class="api" label={`${tag} methods`}>
          <tp-table-header>
            <tp-table-row>
              <tp-table-head>Method</tp-table-head>
              <tp-table-head>Returns</tp-table-head>
              <tp-table-head>Description</tp-table-head>
            </tp-table-row>
          </tp-table-header>
          <tp-table-body>
            {methods.map((method) => (
              <tp-table-row>
                <tp-table-head scope="row">
                  <code>{method.signature}</code>
                </tp-table-head>
                <tp-table-cell>{method.returns ? <code>{method.returns}</code> : '—'}</tp-table-cell>
                <tp-table-cell>
                  {method.description
                    ? prose(method.description).map((part, index) => (index % 2 ? <code>{part}</code> : part))
                    : '—'}
                </tp-table-cell>
              </tp-table-row>
            ))}
          </tp-table-body>
        </tp-table>
      )}
      {api.events.length > 0 && (
        <p>
          Events: {api.events.map((event, index) => (
            <>
              {index > 0 && ', '}
              <code>{event}</code>
            </>
          ))}
          .
        </p>
      )}
      <p class="api-note">
        Read from the <code>@tweakpad/ui@{uiVersion}</code> custom elements manifest for{' '}
        <code>{api.className}</code>. Every element also accepts <code>motion-policy</code>.
      </p>
    </div>
  ) : (
    <p>
      No manifest entry for <code>{tag}</code>.
    </p>
  )
}

<style>
  .api-note {
    color: var(--tp-muted-foreground);
    font-size: 0.8125rem;
  }

  .api-flag {
    display: block;
    margin-block-start: 0.25rem;
    color: var(--tp-muted-foreground);
    font-size: 0.75rem;
  }
</style>
