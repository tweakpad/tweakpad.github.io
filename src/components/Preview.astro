---
/**
 * A live example: the markup renders as-is on a canvas, and the same markup is the copyable code.
 * The toolbar is three icon controls with tooltips: a joined Default/Compact density pair (shared
 * by every preview on the page), a Refresh button that remounts the demo in its initial state,
 * and a Code toggle that reveals the source in the library's Code block, with its copy action.
 *
 * `script` is for behavior markup can't express (opening a dialog, feeding chart data, raising a
 * toast, installing a text editor's engine). It runs as a module after the markup, and the copyable code shows it in a script tag.
 * Scripts on one page share the document, so they select their elements by page-unique ids.
 * Refresh runs the script again against the fresh markup, so a script that listens on `document`
 * or `window` ignores events once its own elements are disconnected.
 *
 * A script may import from `@tweakpad/ui`, its subpath entries, `lit` and the Tiptap modules the
 * text editor runs on, as an app would: named imports (`import { a } from`) and namespace imports
 * (`import * as a from`). Inline scripts can't resolve bare specifiers, so the page runs a copy
 * where each such import reads the module from the site's own bundle (see `previewModules`
 * below); the copyable code keeps the import as written.
 */
interface Props {
  code: string;
  title?: string;
  /** `center` (default) for a single control, `start` or `stretch` for wider compositions. */
  align?: 'center' | 'start' | 'stretch';
  /** Opens with the code visible. */
  showCode?: boolean;
  language?: string;
  script?: string;
}

const {
  code,
  title = 'Preview',
  align = 'center',
  showCode = false,
  language = 'html',
  script,
} = Astro.props;
const markup = code.trim();
const behavior = script?.trim();

/** The modules the site hands to preview scripts at runtime; keep in step with `previewModules`. */
const SPECIFIER =
  "['\"](@tweakpad\\/ui(?:\\/(?:drag-drop|emoji|carousel|media|map|markdown|qr|flow|widgets|text-editor))?|lit|@tiptap\\/(?:core|starter-kit|extension-list|extension-table|pm\\/(?:state|history|tables)))['\"];?$";
const NAMED_IMPORT = new RegExp(`^import\\s*\\{([^}]*)\\}\\s*from\\s*${SPECIFIER}`, 'gm');
const NAMESPACE_IMPORT = new RegExp(`^import\\s*\\*\\s*as\\s+([\\w$]+)\\s+from\\s*${SPECIFIER}`, 'gm');
const load = (specifier: string) => `await (await window.__tpPreviewModules.ready)('${specifier}')`;
const runnable = behavior
  ?.replace(NAMED_IMPORT, (_, names: string, specifier: string) => {
    const bindings = names
      .split(',')
      .map((name) => name.trim().replace(/\s+as\s+/, ': '))
      .filter(Boolean)
      .join(', ');
    return `const { ${bindings} } = ${load(specifier)};`;
  })
  .replace(NAMESPACE_IMPORT, (_, name: string, specifier: string) => `const ${name} = ${load(specifier)};`);
const source = behavior
  ? `${markup}\n\n<script type="module">\n${behavior}\n</script>`
  : markup;
---

<figure class="preview" data-preview data-density="default">
  <div class="preview__bar">
    <figcaption class="preview__title">{title}</figcaption>
    <div class="preview__tools">
      <!--
        Icon-only toggles, named for assistive technology and explained by tooltips. A tooltip's
        text that repeats the name is visual only (`describes="none"`). Icons are set by the script.
      -->
      <tp-toggle-group
        data-density-control
        label="Density"
        size="icon-sm"
        variant="outline"
        spacing="0"
        default-value='["default"]'
      >
        <tp-tooltip describes="none">
          <tp-toggle slot="trigger" value="default" aria-label="Default density">
            <tp-icon data-icon="density-default"></tp-icon>
          </tp-toggle>
          Default density
        </tp-tooltip>
        <tp-tooltip describes="none">
          <tp-toggle slot="trigger" value="compact" aria-label="Compact density">
            <tp-icon data-icon="density-compact"></tp-icon>
          </tp-toggle>
          Compact density
        </tp-tooltip>
      </tp-toggle-group>
      <tp-tooltip>
        <tp-button
          slot="trigger"
          data-refresh-control
          size="icon-sm"
          variant="outline"
          aria-label="Refresh preview"
        />
        Restart from the initial state
      </tp-tooltip>
      <tp-tooltip>
        <tp-toggle
          slot="trigger"
          data-code-control
          size="icon-sm"
          variant="outline"
          aria-label="Code"
          default-pressed={showCode || undefined}
        >
          <tp-icon data-icon="code"></tp-icon>
        </tp-toggle>
        Show the copyable source
      </tp-tooltip>
    </div>
  </div>
  <div class="preview__canvas" data-align={align} set:html={markup} />
  <template data-source set:html={markup} />
  {runnable && <script is:inline type="module" data-behavior data-astro-rerun set:html={runnable} />}
  <div class="preview__code" hidden={!showCode} data-code>
    <tp-code-block language={language} copyable>{source}</tp-code-block>
  </div>
</figure>

<script>
  import type { TpButton, TpIcon, TpToggle, TpToggleGroup } from '@tweakpad/ui';
  import type { IconDefinition } from '@tweakpad/ui/icons/types';
  import { refreshIcon } from '@tweakpad/ui/icons/refresh';
  import { codeIcon, densityCompactIcon, densityDefaultIcon } from '../lib/icons';

  /** The toolbar's artwork, by the `data-icon` name on each tp-icon. */
  const toolbarIcons: Record<string, IconDefinition> = {
    'density-default': densityDefaultIcon,
    'density-compact': densityCompactIcon,
    code: codeIcon,
  };

  /** The modules preview scripts may import, loaded on first use; see the import rewrites above. */
  const previewModules: Record<string, () => Promise<unknown>> = {
    '@tweakpad/ui': () => import('@tweakpad/ui'),
    '@tweakpad/ui/drag-drop': () => import('@tweakpad/ui/drag-drop'),
    '@tweakpad/ui/emoji': () => import('@tweakpad/ui/emoji'),
    '@tweakpad/ui/carousel': () => import('@tweakpad/ui/carousel'),
    '@tweakpad/ui/media': () => import('@tweakpad/ui/media'),
    '@tweakpad/ui/map': () => import('@tweakpad/ui/map'),
    '@tweakpad/ui/markdown': () => import('@tweakpad/ui/markdown'),
    '@tweakpad/ui/qr': () => import('@tweakpad/ui/qr'),
    '@tweakpad/ui/flow': () => import('@tweakpad/ui/flow'),
    '@tweakpad/ui/widgets': () => import('@tweakpad/ui/widgets'),
    '@tweakpad/ui/text-editor': () => import('@tweakpad/ui/text-editor'),
    lit: () => import('lit'),
    // The engine of the text editor demos.
    '@tiptap/core': () => import('@tiptap/core'),
    '@tiptap/starter-kit': () => import('@tiptap/starter-kit'),
    '@tiptap/extension-list': () => import('@tiptap/extension-list'),
    '@tiptap/extension-table': () => import('@tiptap/extension-table'),
    '@tiptap/pm/state': () => import('@tiptap/pm/state'),
    '@tiptap/pm/history': () => import('@tiptap/pm/history'),
    '@tiptap/pm/tables': () => import('@tiptap/pm/tables'),
  };
  window.__tpPreviewModules?.resolve((specifier) => previewModules[specifier]!());

  type PreviewImport = (specifier: string) => Promise<unknown>;

  declare global {
    interface Window {
      __tpPreviewModules?: {
        ready: Promise<PreviewImport>;
        resolve(load: PreviewImport): void;
      };
    }
  }

  type Density = 'default' | 'compact';
  const STORAGE_KEY = 'tp-site-density';

  const readDensity = (): Density => {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'compact' ? 'compact' : 'default';
    } catch {
      return 'default';
    }
  };

  /** One density for every preview on the page, remembered across pages. */
  function applyDensity(density: Density) {
    for (const preview of document.querySelectorAll<HTMLElement>('[data-preview]')) {
      preview.dataset.density = density;
      const control = preview.querySelector<TpToggleGroup>('[data-density-control]');
      if (control && control.value[0] !== density) control.setValue([density]);
    }
    try {
      localStorage.setItem(STORAGE_KEY, density);
    } catch {}
  }

  // Module scripts run in document order; the elements may not be defined yet.
  const ready = Promise.all([
    customElements.whenDefined('tp-toggle-group'),
    customElements.whenDefined('tp-toggle'),
    customElements.whenDefined('tp-button'),
    customElements.whenDefined('tp-icon'),
  ]);

  /**
   * Puts the demo back as the page first rendered it: the markup is replaced from its template,
   * which disconnects the old elements (closing their popups and timers), and the behavior script
   * runs again as a new module against the new elements.
   */
  function refresh(preview: HTMLElement) {
    const canvas = preview.querySelector<HTMLElement>('.preview__canvas');
    const source = preview.querySelector<HTMLTemplateElement>('template[data-source]');
    if (!canvas || !source) return;
    canvas.replaceChildren(source.content.cloneNode(true));

    const behavior = preview.querySelector<HTMLScriptElement>('script[data-behavior]');
    if (!behavior) return;
    const rerun = document.createElement('script');
    rerun.type = 'module';
    rerun.dataset.behavior = '';
    rerun.textContent = behavior.textContent;
    behavior.replaceWith(rerun);
  }

  /** Binds the controls of every preview that arrived with the current page. */
  async function setup() {
    await ready;
    for (const preview of document.querySelectorAll<HTMLElement>('[data-preview]:not([data-ready])')) {
      preview.dataset.ready = '';
      bind(preview);
    }
    if (readDensity() === 'compact') applyDensity('compact');
  }

  function bind(preview: HTMLElement) {
    // Demo forms validate and show their states, but never leave the page.
    preview.addEventListener('submit', (event) => event.preventDefault());

    for (const icon of preview.querySelectorAll<TpIcon>('.preview__tools tp-icon[data-icon]')) {
      icon.icon = toolbarIcons[icon.dataset.icon ?? ''];
    }

    const density = preview.querySelector<TpToggleGroup>('[data-density-control]');
    density?.addEventListener('tp-value-change', (event) => {
      if (event.target !== density) return;
      const next = (event as CustomEvent<{ value: readonly string[] }>).detail.value[0];
      // Pressing the selected option would clear a single-selection group; keep one selected.
      if (next !== 'default' && next !== 'compact') {
        event.preventDefault();
        return;
      }
      queueMicrotask(() => applyDensity(next));
    });

    const refreshButton = preview.querySelector<TpButton>('[data-refresh-control]');
    if (refreshButton) {
      refreshButton.icon = refreshIcon;
      refreshButton.addEventListener('click', () => refresh(preview));
    }

    const codeToggle = preview.querySelector<TpToggle>('[data-code-control]');
    const code = preview.querySelector<HTMLElement>('[data-code]');
    codeToggle?.addEventListener('tp-value-change', (event) => {
      if (event.target !== codeToggle || !code) return;
      code.hidden = !(event as CustomEvent<{ value: boolean }>).detail.value;
    });
  }

  // Pages arrive through the client router as well as on first load; this module runs once.
  document.addEventListener('astro:page-load', setup);
  setup();
</script>
